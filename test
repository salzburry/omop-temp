fill <- function(basis = "n", grp = groups) {
  l <- long %>% filter(!is_header, !is.na(n_num), group %in% grp,
                       !(section == "Sex" & label == "Unknown"), !(section == "Race/Ethnicity" & label == "Other/Unknown"),
                       !(label == "Unknown" & section %in% c("Age at diagnosis (categorical)", "Year of Diagnosis")),
                       !grepl("^Outside", label))
  N <- sapply(grp_data, nrow) * 10
  s <- l %>% mutate(n = n_num * 10, pct = round(100 * n / ifelse(section == long$section[1], N[["Overall"]], N[group]), 1),
                    mean = NA_real_, sd = NA_real_)
  if (basis == "n") s$pct <- NA else s$n <- NA
  age <- tibble(section = "Age at diagnosis (years)", label = "Mean (sd)", group = grp, n = NA, pct = NA,
                mean = sapply(grp_data[grp], function(d) mean(d$age, na.rm = TRUE)),
                sd = sapply(grp_data[grp], function(d) sd(d$age, na.rm = TRUE)))
  bind_rows(select(s, section, label, group, n, pct, mean, sd), age)
}
