# 00_setup.R : parameters, connection, source tables
# =============================================================================
# LA-HNSCC RDQ - descriptive characteristics of LA-HNSCC patients in Flatiron,
# compared with SEER. VeevaRIO 338681; asset 61431, Dostarlimab (GSK4057190).
# Source: Flatiron "GSK Dostarlimab Locally Advanced Head & Neck Custom Data",
# July 2026 delivery, data cut-off December 2025.
# =============================================================================

suppressPackageStartupMessages({
  library(DBI); library(dbplyr); library(dplyr); library(tidyr)
  library(lubridate); library(openxlsx)
})

# ---- Parameters ---------------------------------------------------------------
catalog   <- "hive_metastore"
schema    <- "clnprw_flatiron_la_hnc_use"
refresh   <- "2026m07"                 # suffix of every table in this delivery
datacut   <- as.Date("2025-12-31")
dx_years  <- 2019:2025                 # years shown in Table 1
out_dir   <- "/mnt/artifacts/results"
out_stem  <- paste0("TFL_338681_HNSCC_FI_RDQ_v0.1_", toupper(format(Sys.Date(), "%d%b%Y")))
seer_file <- "inputs/seer_table2_laHNSCC.csv"   # SEER comparator for 02_seer_compare.R: SEER RDQ
                                                 # Table 2 (locally advanced HNSCC, 2019-2023)

# Study population (RDQ I/E, updated Nov 2026: "LA definition in Flatiron database").
# Inclusion: an ICD code for one of these primary sites. The RDQ lists ICD-10 /
# ICD-O-3 site codes; Flatiron's Diagnosis table holds ICD-10-CM and ICD-9-CM, so
# each site has both. ICD-10-CM codes base of tongue and pyriform sinus as C01 and
# C12 (no 4th character; C01.9 and C12.9 in the RDQ). Codes are matched on the code
# itself with dots and spaces removed (ICD-10 codes start with a letter, ICD-9 codes
# do not), so a missing or differently spelled DiagnosisCodeSystem does not matter.
incl_sites <- tibble::tribble(
  ~site,                                     ~rdq_codes,                   ~icd10,      ~icd9,
  "Lip",                                     "C00.0-C00.9",                "^C00",      "^140",
  "Base of tongue",                          "C01.9",                      "^C01",      "^1410",
  "Other tongue",                            "C02.0-C02.9",                "^C02",      "^141[1-9]",
  "Gum",                                     "C03.0-C03.9",                "^C03",      "^143",
  "Floor of mouth",                          "C04.0-C04.9",                "^C04",      "^144",
  "Palate",                                  "C05.0-C05.9",                "^C05",      "^145[2-5]",
  "Other mouth",                             "C06.0-C06.9",                "^C06",      "^145[01689]",
  "Tonsil",                                  "C09.0-C09.9",                "^C09",      "^146[0-2]",
  "Oropharynx",                              "C10.0-C10.9",                "^C10",      "^146[3-9]",
  "Hypopharynx",                             "C12.9, C13.0-C13.9",         "^C1[23]",   "^148",
  "Other/ill-defined oral cavity & pharynx", "C14.0, C14.2, C14.8",        "^C14[028]", "^149",
  "Larynx",                                  "C32.0-C32.3, C32.8, C32.9",  "^C32",      "^161")
# Exclusion: an ICD code for a head and neck site not in the list above (this
# replaces the earlier C11/C12 rule). Pyriform sinus C12 is included: the RWB lead's
# email takes precedence over the RDQ form and the SEER Appendix, which leave it
# out. NULL drops the step, so a patient with any included-site code is kept.
excl_other_hn <- tibble::tribble(
  ~site,                                        ~icd10,     ~icd9,
  "Salivary glands (C07-C08)",                  "^C0[78]",  "^142",
  "Nasopharynx (C11)",                          "^C11",     "^147",
  "Nasal cavity, middle ear, sinuses (C30-C31)", "^C3[01]",  "^160")

# Baseline period: days relative to the index date (DiagnosisDate, the initial
# LA-HNSCC diagnosis), both ends included. Type of Reporting Source is read from
# the practices the patient visited in it.
baseline_days <- c(-90, 30)

# Surgery groups (RDQ; SurgeryType coding of Enhanced_LAHNC_PrimarySurgery)
surgery_map <- c("primary tumor resection only"                      = "Resected",
                 "primary tumor resection and lymph node dissection" = "Resected",
                 "lymph node dissection only"                        = "Unresected",
                 "unknown/not specified"                             = "Unknown")
no_surgery_group <- "No surgery record"   # no primary-surgery record: own column; "Unresected"
                                           # or "Unknown" puts these patients in that column instead
seer_no_surgery_group <- "Unresected"      # SEER comparison only (Table 1 unchanged): SEER has no
                                           # such group and counts no surgery as Unresected

# "Receipt of chemotherapy / radiation (1L)" = SEER first course of treatment
first_course_settings <- c("NEOADJUVANT", "INDUCTION CHEMO", "CONCURRENT", "ADJUVANT",
                           "EARLY", "RADIATION THERAPY")   # DrugEpisode.LineSetting
count_cetuximab  <- FALSE              # FALSE: never chemo, whatever DetailedDrugCategory says. SEER*Rx
                                       # codes cetuximab as biologic/immunotherapy for diagnoses from 2013
drug_cohorts     <- NULL               # DrugEpisode.EnhancedCohort value(s) for LA-HNSCC lines;
                                       # NULL = the delivery must hold a single value
rt_lookback_days <- 30                 # RT may start up to 30 days before diagnosis
rt_sites <- c("primary site (includes regional lymph node involvement)",
              "unknown/not documented")                     # RTSite (missing counts too)

# ---- Connection ---------------------------------------------------------------
connect <- function() {
  pwd <- Sys.getenv("DATABRICKS_PWD")
  if (!nzchar(pwd)) stop("Set the DATABRICKS_PWD environment variable.", call. = FALSE)
  dbConnect(odbc::odbc(), dsn = "RWDE", pwd = pwd, timeout = 120)
}
con <- connect()
invisible(dbExecute(con, paste("USE CATALOG", catalog)))

# ---- Source tables ------------------------------------------------------------
# Tables are renamed on load (t_ prefix, "enh", abbreviations such as
# drg_epsode), so each one is found by a pattern on its name without the
# _<refresh> suffix. Exactly one table must match; edit a pattern if needed.
hnc <- "^(t_)?enh(anced)?_?(la_?)?hnc"
tbl_patterns <- c(
  cohort    = paste0(hnc, "$"),                          # Enhanced_LAHNC
  surgery   = paste0(hnc, "_?pr(i|m)[a-z]*_?su?rg"),     # Enhanced_LAHNC_PrimarySurgery
  radiation = paste0(hnc, "_?(ra?d|rt($|_))"),           # Enhanced_LAHNC_RadiationTherapy
  localrec  = paste0(hnc, "_?lo?c[a-z]*_?rec"),          # Enhanced_LAHNC_LocalRecurrence
  metrec    = paste0(hnc, "_?me?t[a-z]*_?rec"),          # Enhanced_LAHNC_MetRecurrence
  drugep    = "^(t_)?(enh(anced)?_?(la_?)?hnc_?)?dr?u?g_?ep",   # DrugEpisode
  diagnosis = "^(t_)?diagnosis$",
  demo      = "^(t_)?demographics?$",
  practice  = "^(t_)?practices?$",
  visit     = "^(t_)?visits?$")

find_tables <- function(tables) {
  tables <- tables[grepl(paste0("_", refresh, "$"), tolower(tables))]
  stems  <- sub(paste0("_", refresh, "$"), "", tolower(tables))
  sapply(names(tbl_patterns), function(k) {
    hit <- tables[grepl(tbl_patterns[[k]], stems)]
    if (length(hit) != 1)
      stop("Table '", k, "': ", length(hit), " tables match pattern ", tbl_patterns[[k]],
           " for refresh ", refresh, ". Tables in the schema:\n  ",
           paste(sort(tables), collapse = "\n  "), call. = FALSE)
    hit
  })
}
schema_tables <- dbGetQuery(con, paste("SHOW TABLES IN", schema))$tableName
tbl_map <- find_tables(schema_tables)
print(tbl_map)

src <- function(key) tbl(con, in_schema(schema, tbl_map[[key]])) %>% rename_with(tolower)



# =============================================================================
# 01_table1.R : study population, Table 1, chemotherapy date check
# =============================================================================
# Writes <stem>.xlsx (Table 1, Attrition, Chemo date check),
# <stem>_table1_long.csv and <stem>_ads.rds to out_dir.
# =============================================================================

norm <- function(x) tolower(gsub("[[:space:]]+", " ", trimws(x)))
fetch <- function(key, ...) src(key) %>% filter(patientid %in% !!ids) %>% select(patientid, ...) %>% collect()
site_of <- function(code, sites) {          # the site whose ICD-10 or ICD-9 pattern matches, else NA
  k <- toupper(gsub("[[:space:].]", "", code))
  out <- rep(NA_character_, length(k))
  for (i in seq_len(NROW(sites))) out[is.na(out) & grepl(paste0(sites$icd10[i], "|", sites$icd9[i]), k)] <- sites$site[i]
  out
}

# ---- Study population ------------------------------------------------------------------
# Flatiron's LA-HNSCC criteria are applied in the delivery; the RDQ limits it to the
# primary sites in incl_sites and drops patients with another head and neck site.
cohort <- src("cohort") %>%
  select(patientid, diagnosisdate, advanceddiagnosisdate, groupstage, hpvstatus) %>% collect() %>%
  mutate(dx_date = as.Date(diagnosisdate), adv_date = as.Date(advanceddiagnosisdate))
stopifnot(!anyDuplicated(cohort$patientid))
ids <- cohort$patientid
dx_codes <- fetch("diagnosis", diagnosiscode) %>%       # the patients' head and neck site codes
  mutate(incl_site = site_of(diagnosiscode, incl_sites), other_hn = site_of(diagnosiscode, excl_other_hn)) %>%
  filter(!is.na(incl_site) | !is.na(other_hn))
in_site <- cohort %>% filter(patientid %in% dx_codes$patientid[!is.na(dx_codes$incl_site)])
cohort  <- in_site %>% filter(!patientid %in% dx_codes$patientid[!is.na(dx_codes$other_hn)])
attrition <- tibble(
  step = c("All patients in Enhanced_LAHNC",
           paste("With an ICD code for an included primary site: C00-C06, C09-C10, C12-C13,",
                 "C14.0/C14.2/C14.8, C32 (ICD-9 140-141, 143-146, 148-149, 161)"),
           if (!is.null(excl_other_hn))
             paste("Excluding patients with an ICD code for another head and neck site:",
                   paste(excl_other_hn$site, collapse = "; "))),
  n_patients = c(length(ids), nrow(in_site), if (!is.null(excl_other_hn)) nrow(cohort)))
print(attrition)
ids <- cohort$patientid

# ---- Surgery group: Resected > Unknown > Unresected per patient --------------------
surg <- fetch("surgery", surgerytype) %>%
  mutate(s = norm(coalesce(surgerytype, "")),
         grp = coalesce(unname(surgery_map[s]),            # values outside the coding: by keyword
                        case_when(grepl("lymph node|neck dissection", s) & !grepl("primary", s) ~ "Unresected",
                                  grepl("resection", s) ~ "Resected", TRUE ~ "Unknown"))) %>%
  group_by(patientid) %>%
  summarise(surg_group = if (any(grp == "Resected")) "Resected" else if (any(grp == "Unknown")) "Unknown"
                         else "Unresected", .groups = "drop")

# ---- Chemotherapy, first course: first-course line + DetailedDrugCategory chemo ------
drugs <- fetch("drugep", linesetting, drugname, detaileddrugcategory, episodedate, enhancedcohort)
if (!is.null(drug_cohorts)) drugs <- filter(drugs, enhancedcohort %in% drug_cohorts)
if (is.null(drug_cohorts) && n_distinct(drugs$enhancedcohort) > 1)   # another disease's lines must not count
  stop("DrugEpisode has several EnhancedCohort values (", paste(unique(drugs$enhancedcohort), collapse = ", "),
       "). Set drug_cohorts in 00_setup.R to the LA-HNSCC value(s).", call. = FALSE)
drugs <- drugs %>%
  mutate(first = toupper(norm(linesetting)) %in% first_course_settings,
         cetux = grepl("cetuximab", norm(coalesce(drugname, ""))),   # by count_cetuximab, not by its category
         chemo = (grepl("chemo", norm(coalesce(detaileddrugcategory, ""))) & !cetux) | (count_cetuximab & cetux))
if (any(drugs$first) && !any(drugs$first & drugs$chemo))
  stop("First-course drug episodes exist but none is chemotherapy - check DetailedDrugCategory.", call. = FALSE)

# ---- Radiation, first course ---------------------------------------------------------
# End of first course = earliest of first locoregional recurrence, distant
# recurrence and AdvancedDiagnosisDate. A month/year-only start date must lie
# wholly inside the window.
first_date <- function(key, col) fetch(key, d = !!rlang::sym(col)) %>% mutate(d = as.Date(d)) %>%
  filter(!is.na(d)) %>% group_by(patientid) %>% summarise(d = min(d), .groups = "drop")
fc_end <- cohort %>% select(patientid, dx_date, adv_date) %>%
  left_join(first_date("localrec", "localrecurdate") %>% rename(lr = d), by = "patientid") %>%
  left_join(first_date("metrec", "distantmetdate") %>% rename(dm = d), by = "patientid") %>%
  transmute(patientid, dx_date, fc_end = pmin(adv_date, lr, dm, na.rm = TRUE))
rt_ids <- fetch("radiation", rtstartdate, rtstartdategranularity, rtsite) %>%
  filter(norm(coalesce(rtsite, "Unknown/not documented")) %in% rt_sites) %>%
  mutate(start = as.Date(rtstartdate), g = toupper(coalesce(trimws(rtstartdategranularity), "DAY")),
         lo = case_when(g == "YEAR" ~ floor_date(start, "year"), g == "MONTH" ~ floor_date(start, "month"),
                        TRUE ~ start),
         hi = case_when(g == "YEAR" ~ ceiling_date(start, "year", change_on_boundary = TRUE) - 1,
                        g == "MONTH" ~ ceiling_date(start, "month", change_on_boundary = TRUE) - 1,
                        TRUE ~ start)) %>%
  inner_join(fc_end, by = "patientid") %>%
  filter(!is.na(start), lo >= dx_date - rt_lookback_days, is.na(fc_end) | hi < fc_end) %>%
  pull(patientid)

# ---- Analysis dataset: one row per patient --------------------------------------------
outside <- sprintf("Outside %d-%d", min(dx_years), max(dx_years))
stage_of <- function(x) {
  y <- toupper(gsub("(?i)stage|\\s", "", x, perl = TRUE))
  case_when(grepl("^(0|0IS|T?IS)$", y) ~ "0", grepl("^IV[ABC]?$", y) ~ "IV", grepl("^III[ABC]?$", y) ~ "III",
            grepl("^II[ABC]?$", y) ~ "II", grepl("^I[ABC]?$", y) ~ "I", TRUE ~ "Unknown")
}
demo <- fetch("demo", birthyear, birthsex, race, ethnicity)
if (anyDuplicated(demo$patientid)) stop("Demographics has more than one row for a patient.", call. = FALSE)
# Type of Reporting Source: PracticeType of the practices with a visit in the
# baseline period (Visit.PracticeID joined to Practice on patient and practice).
# No visit in the baseline period = Unknown.
visits <- src("visit") %>% filter(patientid %in% !!ids) %>% distinct(patientid, practiceid, visitdate) %>% collect() %>%
  left_join(distinct(fetch("practice", practiceid, practicetype)), by = c("patientid", "practiceid"),
            relationship = "many-to-many") %>%
  left_join(select(cohort, patientid, dx_date), by = "patientid") %>%
  mutate(day = as.numeric(as.Date(visitdate) - dx_date),
         baseline = !is.na(day) & day >= baseline_days[1] & day <= baseline_days[2])
practice <- visits %>% filter(baseline) %>% group_by(patientid) %>%
  summarise(acad = any(norm(practicetype) %in% "academic"), comm = any(norm(practicetype) %in% "community"))
ads <- cohort %>%
  left_join(demo, by = "patientid") %>%
  left_join(practice, by = "patientid") %>%
  left_join(surg, by = "patientid") %>%
  mutate(
    surg_group = factor(coalesce(surg_group, no_surgery_group),
                        unique(c("Unresected", "Resected", "Unknown", no_surgery_group))),
    sex = factor(case_when(norm(birthsex) %in% c("f", "female") ~ "Female",
                           norm(birthsex) %in% c("m", "male") ~ "Male", TRUE ~ "Unknown"),
                 c("Male", "Female", "Unknown")),
    age = year(dx_date) - suppressWarnings(as.numeric(birthyear)),          # birth year only
    age_cat = cut(age, c(-Inf, 17, 39, 64, 74, Inf),
                  c("<18 years", "18-39 years", "40-64 years", "65-74 years", "75+ years")),
    race_eth = factor(case_when(
      norm(race) == "hispanic or latino" | norm(ethnicity) == "hispanic or latino" ~ "Hispanic (All Races)",
      norm(race) == "white" ~ "Non-Hispanic White",
      norm(race) == "black or african american" ~ "Non-Hispanic Black",
      norm(race) == "american indian or alaska native" ~ "Non-Hispanic American Indian/Alaska Native",
      norm(race) %in% c("asian", "native hawaiian or other pacific islander") ~ "Non-Hispanic Asian or Pacific Islander",
      TRUE ~ "Other/Unknown"),
      c("Non-Hispanic White", "Non-Hispanic Black", "Non-Hispanic American Indian/Alaska Native",
        "Non-Hispanic Asian or Pacific Islander", "Hispanic (All Races)", "Other/Unknown")),
    dx_year = factor(ifelse(is.na(dx_date), NA, ifelse(year(dx_date) %in% dx_years, year(dx_date), outside)),
                     c(dx_years, if (any(!is.na(dx_date) & !year(dx_date) %in% dx_years)) outside)),
    stage = factor(stage_of(groupstage), c("0", "I", "II", "III", "IV", "Unknown")),
    hpv = factor(case_when(norm(hpvstatus) == "hpv positive" ~ "Positive",
                           norm(hpvstatus) == "hpv negative" ~ "Negative", TRUE ~ "Other/Unknown"),
                 c("Positive", "Negative", "Other/Unknown")),
    chemo = factor(ifelse(patientid %in% drugs$patientid[drugs$first & drugs$chemo], "Yes", "No/Unknown"),
                   c("Yes", "No/Unknown")),
    radiation = factor(ifelse(patientid %in% rt_ids, "Yes", "No/Unknown"), c("Yes", "No/Unknown")),
    reporting = factor(case_when(acad & comm ~ "Both Academic and Community", acad ~ "Academic",
                                 comm ~ "Community", TRUE ~ "Unknown"),
                       c("Academic", "Community", "Both Academic and Community", "Unknown")))
if (nrow(ads) != nrow(cohort) || anyDuplicated(ads$patientid))
  stop("The analysis dataset must have exactly one row per cohort patient.", call. = FALSE)

# ---- Table 1: Overall | Unresected | Resected | Unknown [| No surgery record] (n, column %)
groups   <- c("Overall", levels(ads$surg_group))
grp_data <- c(list(Overall = ads), split(ads, ads$surg_group))
block <- function(var, header) {
  body <- bind_rows(lapply(groups, function(g) {
    d <- grp_data[[g]]
    if (var == "age") {                                                     # continuous
      q <- quantile(d$age, c(.25, .5, .75), na.rm = TRUE)
      return(tibble(label = c("Mean (sd)", "Median [IQR]"), group = g, n_num = NA, pct = "",
                    n = if (all(is.na(d$age))) "-" else
                      c(sprintf("%.1f (%s)", mean(d$age, na.rm = TRUE),
                                ifelse(sum(!is.na(d$age)) > 1, sprintf("%.1f", sd(d$age, na.rm = TRUE)), "-")),
                        sprintf("%.1f [%.1f, %.1f]", q[2], q[1], q[3]))))
    }
    x <- if (var == "overall") rep("Overall", nrow(d)) else as.character(d[[var]])
    x[is.na(x)] <- "Unknown"                                                # "Unknown" row only if missing
    levs <- if (var == "overall") "Overall" else c(levels(ads[[var]]), if (anyNA(ads[[var]])) "Unknown")
    n <- vapply(levs, function(l) sum(x == l), numeric(1))
    den <- if (var == "overall") nrow(ads) else nrow(d)
    tibble(label = levs, group = g, n_num = n, n = as.character(n),
           pct = if (den > 0) sprintf("%.1f", 100 * n_num / den) else "-")
  }))
  bind_rows(tibble(label = header, group = groups, n = "", n_num = NA, pct = "", is_header = TRUE),
            mutate(body, is_header = FALSE)) %>% mutate(section = header)
}
# Baseline identifier of each variable (Table 1 "Baseline variable" column):
# Yes = assessed at the index date (diagnosis) or in the baseline period;
# No = time-invariant, not tied to a date, or assessed after the baseline period.
baseline_var <- c(
  "Sex"                            = "No",    # time-invariant (Demographics)
  "Age at diagnosis (years)"       = "Yes",   # at the index date
  "Age at diagnosis (categorical)" = "Yes",
  "Race/Ethnicity"                 = "No",    # time-invariant (Demographics)
  "Year of Diagnosis"              = "Yes",   # index date
  "Stage at diagnosis"             = "Yes",   # at the index date
  "HPV status"                     = "No",    # patient-level HPVStatus, no assessment date
  "Receipt of chemotherapy (1L)"   = "No",    # first course of treatment, after the baseline period
  "Receipt of radiation (1L)"      = "No",
  "Type of Reporting Source"       = "Yes")   # visits in the baseline period
long <- bind_rows(
  block("overall", "Incidence of Head and Neck Squamous Cell Carcinoma"), block("sex", "Sex"),
  block("age", "Age at diagnosis (years)"), block("age_cat", "Age at diagnosis (categorical)"),
  block("race_eth", "Race/Ethnicity"), block("dx_year", "Year of Diagnosis"),
  block("stage", "Stage at diagnosis"), block("hpv", "HPV status"),
  block("chemo", "Receipt of chemotherapy (1L)"), block("radiation", "Receipt of radiation (1L)"),
  block("reporting", "Type of Reporting Source")) %>%
  mutate(baseline = coalesce(unname(baseline_var[section]), ""))   # Incidence row: not a variable
if (!setequal(names(baseline_var), setdiff(unique(long$section), long$section[1])))
  stop("baseline_var must name every Table 1 variable once.", call. = FALSE)
table1 <- long %>%
  pivot_wider(id_cols = c(section, label, is_header, baseline), names_from = group, values_from = c(n, pct)) %>%
  select(section, label, baseline, is_header,
         all_of(as.vector(rbind(paste0("n_", groups), paste0("pct_", groups)))))

footnotes <- c(
  paste0("Source: Flatiron GSK Dostarlimab LA Head & Neck custom data (", schema, ", refresh ", refresh,
         "); data cut-off ", format(datacut, "%d%b%Y"), "."),
