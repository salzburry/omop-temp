################################################################################
# FILE: cml_tki_rdq/cml_tki_rdq.R
################################################################################
# =============================================================================
# CML TKI RDQ: 1L and 2L TKI market share, patient characteristics and time to
# 2L TKI start in newly diagnosed CML. Merative MarketScan Commercial and
# Medicare, data cut 2026Q3. Asset 61865.
#
# Run on the platform with DATABRICKS_PWD set:  source("cml_tki_rdq.R")
# Fill in ms_schema and the table names first (find_tables.R lists them).
# Writes to out_dir:
#   <out_stem>.xlsx         Table 1 (attrition), Table 2 (1L share by quarter), Table 3
#                           (characteristics and 2L by 1L TKI), Figure 1 data, Data checks,
#                           Open questions
#   <out_stem>_Figure1.pdf  Kaplan-Meier curves of time to 2L TKI start (1a-1g)
#   <out_stem>_ads.rds      patient-level analysis dataset, for QC
# The run stops, writing nothing, if the data or the outputs fail a check.
# Open questions behind the settings: docs/open_questions.md.
# =============================================================================

suppressPackageStartupMessages({ library(DBI); library(dplyr); library(openxlsx); library(survival) })

# ---- Settings ------------------------------------------------------------------
catalog   <- "hive_metastore"
ms_schema <- "TO_CONFIRM"                      # MarketScan schema: run find_tables.R
# MarketScan tables, Commercial (CCAE) and Medicare (MDCR). List every table of each kind
# (per-year tables such as ccaeo231, ccaeo241 all go in); rows are combined by ENROLID.
enrol_tables <- c("ccaet", "mdcrt")            # T: enrollment detail, one row per member month
rx_tables    <- c("ccaed", "mdcrd")            # D: outpatient pharmaceutical claims
dx_tables <- tibble::tribble(                  # claims with diagnoses (PDX, DX1, DX2, ...)
  ~table,  ~setting,     ~date_col,
  "ccaes", "inpatient",  "svcdate",            # S: inpatient services
  "mdcrs", "inpatient",  "svcdate",
  "ccaeo", "outpatient", "svcdate",            # O: outpatient services
  "mdcro", "outpatient", "svcdate")
redbook_table <- "redbook"                     # RED BOOK: NDCNUM to generic name (GENNME)

out_dir  <- "/mnt/artifacts/results"
out_stem <- paste0("TFL_CML_TKI_MS_RDQ_v0.1_", toupper(format(Sys.Date(), "%d%b%Y")))

study_start   <- as.Date("2022-01-01")
index_window  <- as.Date(c("2023-01-01", "2026-06-30"))   # inclusive
data_end      <- as.Date("2026-09-30")         # end of the 2026Q3 data cut
min_age       <- 18
baseline_days <- 365                           # baseline: index - 365 days to index - 1 day
op_min_days   <- 30                            # 2 outpatient claims at least 30 days apart (Q2)
max_gap_days  <- 30                            # enrollment gaps of up to 30 days are bridged (Q4)
prior_tki     <- "baseline"                    # Q5: no TKI in the "baseline", or "any" time from study_start
l1_days       <- 90                            # 1L: first TKI 0-90 days after index (Q6)
t2_quarter_of <- "index"                       # Q7: Table 2 rows by quarter of "index" or "1L start"
l2_min_days   <- 30                            # 2L: a different TKI more than 30 days after 1L start (Q8)

cml_code    <- "C9210"                         # identifies CML (form's code list)
prior_codes <- c("C9210", "C9211", "C9212")    # prior CML diagnoses, excluded in baseline
tkis <- c("Imatinib", "Nilotinib", "Dasatinib", "Bosutinib", "Ponatinib", "Asciminib")

# ---- Helpers ---------------------------------------------------------------------
fail <- function(...) stop(..., call. = FALSE)
if (identical(ms_schema, "TO_CONFIRM")) fail("Set ms_schema and the table names at the top of the script (find_tables.R lists them).")
if (!prior_tki %in% c("baseline", "any")) fail("prior_tki must be \"baseline\" or \"any\".")
if (!t2_quarter_of %in% c("index", "1L start")) fail("t2_quarter_of must be \"index\" or \"1L start\".")

to_date <- function(x) {
  if (inherits(x, "Date")) return(x)
  if (inherits(x, "POSIXt")) { tz <- attr(x, "tzone")
    return(as.Date(format(x, "%Y-%m-%d", tz = if (length(tz) && nzchar(tz[1])) tz[1] else "UTC"))) }
  as.Date(substr(trimws(as.character(x)), 1, 10), format = "%Y-%m-%d")
}
# Dates of a column; stops on values that are not dates
dates <- function(x, what) {
  d <- to_date(x)
  bad <- !is.na(x) & trimws(as.character(x)) != "" & is.na(d)
  if (any(bad)) fail(what, ": ", sum(bad), " value(s) not read as dates, e.g. ",
                     paste(head(unique(as.character(x[bad])), 3), collapse = ", "))
  d
}
# ENROLID as text (numeric IDs without scientific notation)
as_id <- function(x) {
  out <- if (is.numeric(x)) format(x, scientific = FALSE, trim = TRUE) else trimws(as.character(x))
  out[is.na(x)] <- NA
  out
}
year <- function(d) as.numeric(format(d, "%Y"))
fmt  <- function(d) sub("^0", "", format(d, "%d %b %Y"))
dot  <- function(code) sub("^(...)", "\\1.", code)                     # C9210 -> C92.10
f1   <- function(x) formatC(x, format = "f", digits = 1)
np   <- function(n, d) if (d == 0) "0" else paste0(n, " (", f1(100 * n / d), "%)")
mean_s <- function(x) { x <- x[!is.na(x)]; if (length(x)) f1(mean(x)) else "-" }
med_s  <- function(x) { x <- x[!is.na(x)]; if (!length(x)) return("-")
  q <- quantile(x, c(0.5, 0.25, 0.75), names = FALSE); paste0(f1(q[1]), " (", f1(q[2]), ", ", f1(q[3]), ")") }
qlab <- function(d) paste0("Q", (as.integer(format(d, "%m")) - 1) %/% 3 + 1, " ", format(d, "%Y"))
lab <- function(l) vapply(l, function(x) if (length(x) == 0) NA_character_ else if (length(x) == 1) x else "Multiple", "")

# TKI of each RED BOOK generic name (matched on the generic name, any salt or form)
tki_of <- function(g) {
  m <- matrix(vapply(tolower(tkis), function(k) grepl(k, tolower(g), fixed = TRUE), logical(length(g))), ncol = length(tkis))
  two <- rowSums(m) > 1
  if (any(two)) fail("RED BOOK generic name(s) matching two TKIs: ", paste(unique(g[two]), collapse = ", "))
  ifelse(rowSums(m) == 0, NA_character_, tkis[max.col(m, ties.method = "first")])
}

# ---- Connect ---------------------------------------------------------------------
connect <- function() {
  pwd <- Sys.getenv("DATABRICKS_PWD")
  if (!nzchar(pwd)) fail("Set the DATABRICKS_PWD environment variable.")
  con <- dbConnect(odbc::odbc(), dsn = "RWDE", pwd = pwd, timeout = 120, bigint = "numeric")
  invisible(dbExecute(con, paste("USE CATALOG", catalog)))
  con
}
con <- connect()

q  <- function(sql) { d <- dbGetQuery(con, sql); names(d) <- tolower(names(d)); d }
tn <- function(t) paste(ms_schema, t, sep = ".")
all_tables <- unique(c(enrol_tables, rx_tables, dx_tables$table, redbook_table))
tcols <- setNames(lapply(all_tables, function(t) names(q(paste("SELECT * FROM", tn(t), "LIMIT 0")))), all_tables)
need <- function(t, cols) { miss <- setdiff(cols, tcols[[t]])
  if (length(miss)) fail(t, ": column(s) not found: ", paste(miss, collapse = ", ")) }
for (t in enrol_tables) need(t, c("enrolid", "dtstart", "dtend", "dobyr", "sex", "rx"))
for (t in rx_tables) need(t, c("enrolid", "svcdate", "ndcnum"))
need(redbook_table, c("ndcnum", "gennme"))
for (i in seq_len(nrow(dx_tables))) need(dx_tables$table[i], c("enrolid", dx_tables$date_col[i]))
dx_tables$dx_cols <- lapply(dx_tables$table, function(t) {
  d <- grep("^(pdx|dx[0-9]+)$", tcols[[t]], value = TRUE)
  if (!length(d)) fail(t, ": no diagnosis columns (PDX, DX1, DX2, ...).")
  d
})

# SQL: any diagnosis column holds one of the codes (dots, spaces and case ignored)
code_sql <- function(cols, codes) paste0("(", paste0("UPPER(REPLACE(TRIM(", cols, "), '.', '')) IN (",
                                                     paste0("'", codes, "'", collapse = ", "), ")", collapse = " OR "), ")")
# SQL: patients with a C92.10 claim (restricts the enrollment and pharmacy reads)
ids_sql <- paste(vapply(seq_len(nrow(dx_tables)), function(i)
  paste0("SELECT enrolid FROM ", tn(dx_tables$table[i]), " WHERE ", code_sql(dx_tables$dx_cols[[i]], cml_code)), ""),
  collapse = " UNION ")
tki_sql <- paste0("(", paste0("LOWER(gennme) LIKE '%", tolower(tkis), "%'", collapse = " OR "), ")")

# ---- Read ------------------------------------------------------------------------
# CML claims (C92.10, C92.11, C92.12): one row per patient, date and table
dx_all <- bind_rows(lapply(seq_len(nrow(dx_tables)), function(i) {
  t <- dx_tables$table[i]; dc <- dx_tables$dx_cols[[i]]; dcol <- dx_tables$date_col[i]
  d <- q(paste0("SELECT DISTINCT enrolid, ", dcol, " AS dxdate, CASE WHEN ", code_sql(dc, cml_code),
                " THEN 1 ELSE 0 END AS cml FROM ", tn(t), " WHERE ", code_sql(dc, prior_codes)))
  tibble(enrolid = as_id(d$enrolid), date = dates(d$dxdate, paste(t, dcol)), cml = as.numeric(d$cml) == 1,
         setting = dx_tables$setting[i], table = t)
}))
if (!any(dx_all$cml)) fail("No ", dot(cml_code), " claims found: check the claims tables and their diagnosis columns.")
dx <- filter(dx_all, !is.na(date), date >= study_start, date <= data_end)

# Enrollment months of these patients; RX = drug coverage
enrol <- bind_rows(lapply(enrol_tables, function(t) {
  d <- q(paste0("SELECT enrolid, dtstart, dtend, dobyr, sex, rx FROM ", tn(t), " WHERE enrolid IN (", ids_sql, ")"))
  tibble(enrolid = as_id(d$enrolid), start = dates(d$dtstart, paste(t, "dtstart")), end = dates(d$dtend, paste(t, "dtend")),
         dobyr = suppressWarnings(as.numeric(as.character(d$dobyr))), sex = toupper(trimws(as.character(d$sex))),
         rx_value = toupper(trimws(as.character(d$rx))), table = t)
}))
rx_bad <- setdiff(unique(na.omit(enrol$rx_value)), c("1", "0", "Y", "N", "YES", "NO", "TRUE", "FALSE", ""))
if (length(rx_bad)) fail("RX (drug coverage) value(s) not recognised: ", paste(rx_bad, collapse = ", "))
enrol$rx <- enrol$rx_value %in% c("1", "Y", "YES", "TRUE")

# TKI NDCs in RED BOOK, and the TKI dispensings of these patients
rb <- q(paste0("SELECT DISTINCT ndcnum, gennme FROM ", tn(redbook_table), " WHERE ", tki_sql))
if (!nrow(rb)) fail("No TKI NDCs found in ", redbook_table, " (GENNME).")
rb$tki <- tki_of(rb$gennme)
fills <- bind_rows(lapply(rx_tables, function(t) {
  d <- q(paste0("SELECT DISTINCT d.enrolid, d.svcdate, r.gennme FROM ", tn(t), " d INNER JOIN (SELECT DISTINCT ndcnum, gennme FROM ",
                tn(redbook_table), " WHERE ", tki_sql, ") r ON d.ndcnum = r.ndcnum WHERE d.enrolid IN (", ids_sql, ")"))
  tibble(enrolid = as_id(d$enrolid), date = dates(d$svcdate, paste(t, "svcdate")), gennme = as.character(d$gennme), table = t)
}))
fills <- fills %>% mutate(tki = tki_of(gennme)) %>% filter(!is.na(date), date <= data_end, !is.na(tki)) %>% distinct(enrolid, date, tki)

# Latest date in each table (against data_end)
latest <- bind_rows(
  lapply(seq_len(nrow(dx_tables)), function(i) tibble(table = dx_tables$table[i], col = dx_tables$date_col[i])),
  tibble(table = rx_tables, col = "svcdate"), tibble(table = enrol_tables, col = "dtend")) %>%
  rowwise() %>%
  mutate(last = dates(q(paste0("SELECT MAX(", col, ") AS last FROM ", tn(table)))$last, table)) %>%
  ungroup()

# ---- Enrollment periods ------------------------------------------------------------
# Months with medical and drug coverage, joined across tables; gaps of up to `gap` days bridged
make_spans <- function(e, gap) {
  e %>% filter(rx, !is.na(start), !is.na(end)) %>% arrange(enrolid, start) %>% group_by(enrolid) %>%
    mutate(prev = lag(cummax(as.numeric(end))), span = cumsum(is.na(prev) | as.numeric(start) - prev - 1 > gap)) %>%
    group_by(enrolid, span) %>% summarise(start = min(start), end = max(end), .groups = "drop")
}
# Patients of p enrolled from index - baseline_days to index
baseline_ok <- function(p, sp) {
  ok <- inner_join(select(p, enrolid, index), sp, by = "enrolid") %>%
    filter(start <= index - baseline_days, end >= index)
  p$enrolid %in% ok$enrolid
}
spans <- make_spans(enrol, max_gap_days)

# ---- Patients and attrition (Table 1) ---------------------------------------------
in_window <- function(d) d >= index_window[1] & d <= index_window[2]
op_ok <- function(d) length(d) > 1 && as.numeric(max(d) - min(d)) >= op_min_days
# Diagnosis rule: >= 1 inpatient, or >= 2 outpatient claims at least op_min_days apart
qualify <- function(d) d %>% group_by(enrolid) %>%
  summarise(ip = any(setting == "inpatient"), op = op_ok(date[setting == "outpatient"]), .groups = "drop") %>%
  filter(ip | op)
new  <- filter(dx, cml)
qual <- qualify(filter(new, in_window(date)))
# Index: first C92.10 claim from study_start (each patient once)
pts <- new %>% group_by(enrolid) %>% summarise(index = min(date), .groups = "drop") %>% inner_join(qual, by = "enrolid")

# Birth year and sex: from the enrollment month nearest the index date
demo <- enrol %>% inner_join(select(pts, enrolid, index), by = "enrolid") %>%
  mutate(dist = pmax(as.numeric(start - index), as.numeric(index - end), 0)) %>%        # undated months last
  arrange(enrolid, dist) %>% group_by(enrolid) %>%
  summarise(n_dobyr = n_distinct(dobyr[!is.na(dobyr)]), n_sex = n_distinct(sex[!is.na(sex) & sex != ""]),
            dobyr = dobyr[!is.na(dobyr)][1], sex = sex[!is.na(sex) & sex != ""][1], .groups = "drop")

before <- function(d, p, days) d %>% inner_join(select(p, enrolid, index), by = "enrolid") %>%
  filter(date < index, date >= if (is.null(days)) study_start else index - days) %>% pull(enrolid) %>% unique()

s1 <- pts %>% filter(index >= index_window[1]) %>% left_join(demo, by = "enrolid")
if (!nrow(s1)) fail("No patients at step 1 (newly diagnosed CML in the index window).")
s2 <- s1 %>% filter(coalesce(year(index) - dobyr >= min_age, FALSE))
s3 <- s2[baseline_ok(s2, spans), ]
s4 <- s3 %>% filter(!enrolid %in% before(dx, s3, baseline_days))
s5 <- s4 %>% filter(!enrolid %in% before(fills, s4, if (prior_tki == "baseline") baseline_days))
first_tki <- fills %>% inner_join(select(s5, enrolid, index), by = "enrolid") %>%
  filter(date >= index, date <= index + l1_days) %>%
  group_by(enrolid) %>% filter(date == min(date)) %>%
  summarise(l1_start = first(date), l1_tkis = list(sort(unique(tki))), .groups = "drop")
s6 <- inner_join(s5, first_tki, by = "enrolid")
if (!nrow(s6)) fail("No patients in the final cohort.")

prior_lab <- if (prior_tki == "baseline") " in the baseline period" else paste0(" any time from ", fmt(study_start))
t1 <- tibble(
  Criteria = c(
    paste0("Index CML diagnosis date on/after ", fmt(index_window[1]), " (first ", dot(cml_code), " claim; >= 1 inpatient or >= 2 outpatient ",
           dot(cml_code), " claims >= ", op_min_days, " days apart, ", fmt(index_window[1]), " to ", fmt(index_window[2]), ")"),
    paste0("Age >= ", min_age, " years at the index date"),
    paste0("12 months of continuous enrollment in medical and pharmacy claims prior to index (gaps of up to ", max_gap_days, " days allowed)"),
    paste0("No prior CML diagnoses (", paste(dot(prior_codes), collapse = ", "), ") in the baseline period"),
    paste0("No prior TKI dispensings (pharmacy claims)", prior_lab),
    paste0("At least one TKI dispensing within 3 months (0-", l1_days, " days) after index CML dx")),
  N = c(nrow(s1), nrow(s2), nrow(s3), nrow(s4), nrow(s5), nrow(s6))) %>%
  mutate(`% (of first row)` = f1(100 * N / N[1]), `% (of previous row)` = c(NA, f1(100 * N[-1] / N[-n()])),
         `N excluded` = c(NA, -diff(N)))

# ---- Follow-up and 2L ---------------------------------------------------------------
# Follow-up: 1L start to the end of its enrollment period (gaps bridged) or data_end
fu <- s6 %>% select(enrolid, l1_start) %>% inner_join(spans, by = "enrolid") %>%
  filter(start <= l1_start, end >= l1_start) %>% group_by(enrolid) %>% summarise(fu_end = max(end), .groups = "drop")
ads <- s6 %>% left_join(fu, by = "enrolid") %>%
  mutate(no_span = is.na(fu_end), fu_end = pmin(coalesce(fu_end, l1_start), data_end), fu_days = as.numeric(fu_end - l1_start),
         l1 = lab(l1_tkis))
# 2L: the first TKI not in 1L, more than l2_min_days after the 1L start and within follow-up
new_tki <- fills %>% inner_join(select(ads, enrolid, l1_start, l1_tkis, fu_end), by = "enrolid") %>%
  filter(date > l1_start, !vapply(seq_along(tki), function(i) tki[i] %in% l1_tkis[[i]], TRUE))
l2 <- new_tki %>% filter(date > l1_start + l2_min_days, date <= fu_end) %>%
  group_by(enrolid) %>% filter(date == min(date)) %>%
  summarise(l2_start = first(date), l2_tkis = list(sort(unique(tki))), .groups = "drop")
ads <- ads %>% left_join(l2, by = "enrolid") %>%
  mutate(l2 = lab(l2_tkis), has_2l = !is.na(l2_start), time_2l = as.numeric(l2_start - l1_start),
         km_time = ifelse(has_2l, time_2l, fu_days), age = year(index) - dobyr, male = sex %in% c("1", "M"),
         quarter = qlab(if (t2_quarter_of == "index") index else l1_start))
groups    <- c(tkis, if (any(ads$l1 == "Multiple")) "Multiple")       # 1L columns of Tables 2 and 3
l2_groups <- c(tkis, if (any(ads$l2 %in% "Multiple")) "Multiple")     # 2L rows of Table 3
glab <- function(g, when) ifelse(g == "Multiple", paste("2+ TKIs on the", when, "start date"), g)

# ---- Table 2: 1L TKI share by quarter ---------------------------------------------------
q_end <- if (t2_quarter_of == "index") index_window[2] else max(c(ads$l1_start, index_window[2]))
q_seq <- seq(as.Date(cut(index_window[1], "quarter")), as.Date(cut(q_end, "quarter")), by = "quarter")
q_lev <- qlab(q_seq)
share_row <- function(d, label) {
  n <- vapply(groups, function(g) sum(d$l1 == g), 0)
  as_tibble(as.list(c(setNames(label, paste0("Quarter of ", if (t2_quarter_of == "index") "index CML diagnosis" else "1L start")),
                      setNames(vapply(n, np, "", d = nrow(d)), glab(groups, "1L")),
                      `Total (N)` = as.character(nrow(d)))))
}
t2 <- bind_rows(share_row(ads, paste0("Overall, ", year(index_window[1]), "-", year(q_end), " N (% of row total)")),
                lapply(q_lev, function(l) share_row(filter(ads, quarter == l), l)))

# ---- Table 3: characteristics and 2L by 1L TKI --------------------------------------------
t3_col <- function(d) {
  w <- filter(d, has_2l)
  c(N = nrow(d),
    `Age (years)` = "", `   Mean` = mean_s(d$age), `   Median (Q1, Q3)` = med_s(d$age),
    `Sex, Male, N (%)` = np(sum(d$male), nrow(d)),
    `Follow-up from 1L start (days)` = "", `   Mean` = mean_s(d$fu_days), `   Median (Q1, Q3)` = med_s(d$fu_days),
    `2L TKI, N (% of N)` = np(nrow(w), nrow(d)),
    setNames(vapply(l2_groups, function(k) np(sum(w$l2 == k), nrow(w)), ""),
             paste0("   ", glab(l2_groups, "2L"), ", N (% of patients with 2L)")),
    `Time from 1L to 2L start (days), patients with 2L` = "", `   Mean` = mean_s(w$time_2l),
    `   Median (Q1, Q3)` = med_s(w$time_2l))
}
t3_cols <- c(lapply(setNames(groups, glab(groups, "1L")), function(g) t3_col(filter(ads, l1 == g))), list(Total = t3_col(ads)))
t3 <- tibble(`1L TKI` = names(t3_cols$Total), !!!lapply(t3_cols, unname))

# ---- Figure 1: Kaplan-Meier, time to 2L start ------------------------------------------------
km_sets <- c(list(`All patients` = ads), lapply(setNames(tkis, paste("1L", tolower(tkis))), function(k) filter(ads, l1 == k)))
months <- c(6, 12, 24)
km_row <- function(d, label) {
  out <- tibble(Group = label, N = nrow(d), `Patients with 2L` = sum(d$has_2l))
  if (!nrow(d)) return(out)
  fit <- survfit(Surv(km_time, has_2l) ~ 1, data = d)
  m <- summary(fit)$table
  med <- function(x) if (is.na(x)) "Not reached" else f1(x)
  out$`Median days to 2L (95% CI)` <- paste0(med(m[["median"]]), " (", med(m[["0.95LCL"]]), ", ", med(m[["0.95UCL"]]), ")")
  s <- summary(fit, times = months * 30.4375, extend = TRUE)
  for (k in seq_along(months)) {
    ok <- s$n.risk[k] > 0
    out[[paste0("% with 2L by ", months[k], " months (95% CI)")]] <- if (!ok) "-" else
      paste0(f1(100 * (1 - s$surv[k])), " (", f1(100 * (1 - s$upper[k])), ", ", f1(100 * (1 - s$lower[k])), ")")
    out[[paste0("At risk at ", months[k], " months")]] <- s$n.risk[k]
  }
  out
}
f1_tab <- bind_rows(mapply(km_row, km_sets, names(km_sets), SIMPLIFY = FALSE))

km_plot <- function(d, title) {
  par(mar = c(8, 5, 4, 2))
  if (!nrow(d)) { plot.new(); title(main = title); text(0.5, 0.5, "No patients"); return(invisible()) }
  d$months <- d$km_time / 30.4375
  fit <- survfit(Surv(months, has_2l) ~ 1, data = d)
  ticks <- seq(0, max(12, ceiling(max(d$months) / 6) * 6), by = 6)
  plot(fit, conf.int = TRUE, mark.time = TRUE, xlim = range(ticks), ylim = c(0, 1), xaxt = "n", las = 1,
       xlab = "Months since 1L TKI start", ylab = "Proportion without a 2L TKI", main = title)
  axis(1, at = ticks)
  mtext("Number at risk", side = 1, line = 4, adj = 0, cex = 0.8)
  mtext(summary(fit, times = ticks, extend = TRUE)$n.risk, side = 1, line = 5, at = ticks, cex = 0.8)
}

# ---- Data checks --------------------------------------------------------------------
chk <- function(check, value) tibble(check = check, value = as.character(value))
not_new <- filter(pts, index < index_window[1])
checks <- bind_rows(
  chk("Schema", ms_schema),
  chk(paste0("Latest ", latest$col, " in ", latest$table, " (data_end = ", fmt(data_end), ")"), format(latest$last)),
  chk(paste0("Diagnosis columns searched in ", dx_tables$table), vapply(dx_tables$dx_cols, paste, "", collapse = ", ")),
  chk("CML claims (C92.10-C92.12) with no service date (not used)", sum(is.na(dx_all$date))),
