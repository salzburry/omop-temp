-- ===========================================================================
-- RDQ 337084 — VERIFICATION PASS
--
-- Settles the items still open after the source-document audit. Every filter
-- rewritten from the data dictionary is CHECKED HERE against the real values,
-- because the dictionary and the data can disagree and the dictionary is not
-- the thing the query runs against.
--
-- STATUS after the 2026q1 results in RDQSep3/sql_results.md:
--   Block 1  ANSWERED — coverage_ind domain and open-ended share measured.
--   Block 2  ANSWERED — data_source is rx_adm (no underscore-spelled variant).
--   Block 3  OPEN — discontinue_reason domain.
--   Block 4  OPEN — assumption A03, date vs encounter.
--   Block 5  OPEN — daraxonrasib across all four drug surfaces. THIS IS THE
--            FEASIBILITY QUESTION and the one result still unseen.
--   Block 6  OPEN — funnel re-run carrying the coverage_ind + birth_yr fixes.
--
-- Run blocks 5 and 6 first; 3 and 4 refine assumptions and can follow.
-- ===========================================================================
CREATE WIDGET TEXT cut DEFAULT '2026q1';
USE CATALOG hive_metastore;
USE SCHEMA  clnprw_optum_mc_full_use;


-- ===========================================================================
-- 1. ENROLMENT — did the open-ended-plan fix target the real cause?
--    Step 3 -> 4 went 98,106 -> 0. The dictionary says eligend is NULL for an
--    open-ended plan, and `NULL >= anchor` drops the row. If n_open_ended is
--    large, that was the cause and the COALESCE fixes it.
-- ===========================================================================
DESCRIBE TABLE t_clm_co_enrollment_${cut};

SELECT COUNT(*)                                                   AS n_rows,
       SUM(CASE WHEN eligend IS NULL THEN 1 ELSE 0 END)           AS n_open_ended,
       COUNT(DISTINCT ptid)                                       AS n_pts,
       COUNT(DISTINCT CASE WHEN eligend IS NULL THEN ptid END)    AS n_pts_open_ended,
       CAST(MIN(eligeff) AS STRING) AS min_eligeff,
       CAST(MAX(eligend) AS STRING) AS max_eligend
FROM t_clm_co_enrollment_${cut};

-- The coverage domain. MEASURED on 2026q1: the column is COVERAGE_IND with
-- values Med+Rx (218,770,725), Rx Only (135,501,175), Med Only (72,560,593).
-- `medical_coverage_ind = 'Y'` matched nothing, which is the primary cause of
-- step 4 = 0; the NULL eligend handling (5,798,997 rows, 1.4%) was a second,
-- real defect sitting behind it. Medical coverage is {Med+Rx, Med Only}.
SELECT coverage_ind, COUNT(*) AS n_rows, COUNT(DISTINCT ptid) AS n_pts
FROM t_clm_co_enrollment_${cut}
GROUP BY coverage_ind ORDER BY n_rows DESC;


-- ===========================================================================
-- 2. EO ACTION + DATA_SOURCE — the two filters that were matching NOTHING.
--    The dictionary documents action as {administered, filled, is on,
--    prescribed, started, stopped, suspended} and data_source with a SPACE
--    ("provider notes"). Both filters were rewritten on that basis. This is
--    the check that the data agrees.
-- ===========================================================================
SELECT data_source, action, COUNT(*) AS n_rows, COUNT(DISTINCT ptid) AS n_pts
FROM t_onc_medications_${cut}
GROUP BY data_source, action
ORDER BY n_rows DESC;

-- Explicitly: does the SPACE or the UNDERSCORE spelling exist?
SELECT data_source, LENGTH(data_source) AS len, COUNT(*) AS n
FROM t_onc_medications_${cut}
GROUP BY data_source, LENGTH(data_source) ORDER BY n DESC;


-- ===========================================================================
-- 3. DISCONTINUE_REASON — currently UNUSED. It states why a drug was stopped,
--    which bears directly on whether it was actually taken. If it is populated
--    and meaningful it can sharpen "treatment received" beyond the action flag.
-- ===========================================================================
SELECT 't_prescription' AS surface, discontinue_reason, COUNT(*) AS n_rows
FROM t_prescription_${cut} GROUP BY discontinue_reason
UNION ALL
SELECT 't_administrations', discontinue_reason, COUNT(*)
FROM t_administrations_${cut} GROUP BY discontinue_reason
ORDER BY n_rows DESC LIMIT 40;


-- ===========================================================================
-- 4. ASSUMPTION A03 — "visit" = distinct service date, or distinct ENCOUNTER?
--    t_diagnosis carries encid, so the encounter reading is available on the
--    EHR side. This measures how much the choice actually moves: patients who
--    qualify on 2 distinct DATES but only ONE encounter are qualifying on a
--    single encounter split across days.
-- ===========================================================================
WITH pdac AS (
  SELECT ptid, encid, diag_date
  FROM t_diagnosis_${cut}
  WHERE diagnosis_cd_type = 'ICD10'
    AND REPLACE(diagnosis_cd, '.', '') IN
        ('C250','C251','C252','C253','C257','C258','C259')
    AND diag_date BETWEEN DATE'2020-01-01' AND DATE'2026-03-31'
)
SELECT COUNT(*)                                                        AS pts_2plus_dates,
       SUM(CASE WHEN n_enc  >= 2 THEN 1 ELSE 0 END)                    AS also_2plus_encounters,
       SUM(CASE WHEN n_enc  <  2 THEN 1 ELSE 0 END)                    AS qualify_on_ONE_encounter,
       SUM(CASE WHEN n_enc IS NULL THEN 1 ELSE 0 END)                  AS encid_null
FROM (
  SELECT ptid,
         COUNT(DISTINCT diag_date) AS n_dates,
         COUNT(DISTINCT encid)     AS n_enc,
         DATEDIFF(MAX(diag_date), MIN(diag_date)) AS span
  FROM pdac GROUP BY ptid
) x
WHERE n_dates >= 2 AND span > 30;


-- ===========================================================================
-- 5. DARAXONRASIB — the feasibility question. I have not yet seen this result.
--    A claims zero is EXPECTED on a cut ending before 2026-05-01. A non-zero
--    in t_prescription / t_administrations / t_onc_medications is TRIAL
--    EXPOSURE and is the meaningful signal.
-- ===========================================================================
SELECT surface, drug_text, n_rows, n_pts, first_dt, last_dt FROM (
  SELECT 't_clm_rx' AS surface, UPPER(COALESCE(brnd_nm, gnrc_nm)) AS drug_text,
         COUNT(*) AS n_rows, COUNT(DISTINCT ptid) AS n_pts,
         CAST(MIN(fill_dt) AS STRING) AS first_dt, CAST(MAX(fill_dt) AS STRING) AS last_dt
  FROM t_clm_rx_${cut}
  WHERE UPPER(COALESCE(brnd_nm,'') || ' ' || COALESCE(gnrc_nm,''))
        RLIKE 'RASIB|RMC.?0?70?6236|RASONQUE|DARAXON'
  GROUP BY UPPER(COALESCE(brnd_nm, gnrc_nm))
  UNION ALL
  SELECT 't_prescription', UPPER(COALESCE(drug_name, generic_desc)),
         COUNT(*), COUNT(DISTINCT ptid),
         CAST(MIN(rxdate) AS STRING), CAST(MAX(rxdate) AS STRING)
  FROM t_prescription_${cut}
  WHERE UPPER(COALESCE(drug_name,'') || ' ' || COALESCE(generic_desc,''))
        RLIKE 'RASIB|RMC.?0?70?6236|RASONQUE|DARAXON'
  GROUP BY UPPER(COALESCE(drug_name, generic_desc))
  UNION ALL
  SELECT 't_administrations', UPPER(COALESCE(drug_name, generic_desc)),
         COUNT(*), COUNT(DISTINCT ptid),
         CAST(MIN(COALESCE(admin_date, order_date)) AS STRING),
         CAST(MAX(COALESCE(admin_date, order_date)) AS STRING)
  FROM t_administrations_${cut}
  WHERE UPPER(COALESCE(drug_name,'') || ' ' || COALESCE(generic_desc,''))
        RLIKE 'RASIB|RMC.?0?70?6236|RASONQUE|DARAXON'
  GROUP BY UPPER(COALESCE(drug_name, generic_desc))
  UNION ALL
  SELECT 't_onc_medications', UPPER(COALESCE(drug_name, generic_desc)),
         COUNT(*), COUNT(DISTINCT ptid),
         CAST(MIN(action_date) AS STRING), CAST(MAX(action_date) AS STRING)
  FROM t_onc_medications_${cut}
  WHERE UPPER(COALESCE(drug_name,'') || ' ' || COALESCE(generic_desc,''))
        RLIKE 'RASIB|RMC.?0?70?6236|RASONQUE|DARAXON'
  GROUP BY UPPER(COALESCE(drug_name, generic_desc))
) x ORDER BY n_pts DESC;


-- ===========================================================================
-- 6. RE-RUN THE FUNNEL. Identical to block 9 of sql/rdq2_discovery.sql, inlined
--    so the re-run is one paste. Carries all three fixes measured on 2026q1:
--      - coverage_ind {Med+Rx, Med Only}, not medical_coverage_ind = 'Y'
--      - COALESCE on the open-ended eligend (5,798,997 NULL rows)
--      - the '<year> and Earlier' birth_yr pattern, not a hard-coded 1936
--
--    Expected movement against the first run:
--      step 1  166,044,738 -> ~179M  (the 16.7M "1937 and Earlier" adults return)
--      step 4  0           -> a PARTIAL reduction of 98,106, not all of it
--
--    Step 4 landing on 0 again means the cause is neither the coverage value nor
--    the null end date, and the next thing to check is whether these patients
--    carry enrolment rows at all (block 8c-iv of the discovery file).
-- ===========================================================================
WITH params AS (
  SELECT DATE'2020-01-01' AS study_start,
         DATE'2026-06-01' AS study_end,
         LEAST(DATE'2026-06-01', DATE'2026-03-31') AS ceiling_dt,   -- cut end
         30  AS visit_gap, 180 AS baseline_days, 183 AS enroll_days
),
-- Step 1 — adults in the Market Clarity population.
s1 AS (
  SELECT DISTINCT p.ptid
  FROM t_patient_${cut} p
  WHERE p.market_clarity = 'Y'
    -- MEASURED: the bucket is "1937 and Earlier" on 2026q1. Match the PATTERN so a
    -- relabelled bucket on a later cut does not silently exclude 16.7M adults.
    AND (p.birth_yr RLIKE '^[0-9]{4} and Earlier$'
         OR (p.birth_yr RLIKE '^[0-9]{4}$' AND CAST(p.birth_yr AS INT) <= 2008))
),
-- Claims diagnosis stream, ICD-10 only, bounded by the cut.
dx AS (
  SELECT d.ptid, d.diag AS cd, d.fst_dt AS dt
  FROM t_clm_med_diagnosis_${cut} d, params
  WHERE d.icd_flag = '10' AND d.fst_dt <= params.ceiling_dt
),
-- Step 2 — >=2 distinct C25 dates more than 30 days apart, inside the study period.
pdac_dates AS (
  SELECT DISTINCT dx.ptid, dx.dt
  FROM dx, params
  WHERE dx.cd IN ('C250','C251','C252','C253','C257','C258','C259')
    AND dx.dt >= params.study_start AND dx.dt <= params.ceiling_dt
),
s2 AS (
  SELECT ptid, MIN(dt) AS index_date
  FROM pdac_dates
  GROUP BY ptid
  HAVING COUNT(DISTINCT dt) >= 2
     AND DATEDIFF(MAX(dt), MIN(dt)) > (SELECT visit_gap FROM params)
),
s2c AS (SELECT s2.* FROM s2 JOIN s1 USING (ptid)),
-- Step 3 — metastatic disease on/after index. C79.9x excluded (literal endpoint).
mets AS (
  SELECT s2c.ptid, MIN(dx.dt) AS mets_date
  FROM dx JOIN s2c USING (ptid), params
  WHERE (SUBSTR(dx.cd, 1, 3) IN ('C77','C78')
         OR (SUBSTR(dx.cd, 1, 3) = 'C79' AND SUBSTR(dx.cd, 1, 4) <> 'C799'))
    AND dx.dt >= s2c.index_date AND dx.dt <= params.ceiling_dt
  GROUP BY s2c.ptid
  HAVING COUNT(DISTINCT dx.dt) >= 2
),
s3 AS (SELECT s2c.ptid, s2c.index_date, mets.mets_date FROM s2c JOIN mets USING (ptid)),
-- Step 4 — >=183 days of continuous coverage before the FIRST METASTATIC date.
-- Spans sharing a start date are collapsed to the longest first, then stitched.
spans AS (
  -- COALESCE the NULL: the Optum MC dictionary says eligend "may be null if end date
  -- is not available, indicating an OPEN-ENDED plan". Left as NULL, `eligend >=
  -- anchor` is NULL and the row is dropped — excluding the patients with the most
  -- current coverage, which is what took step 4 to zero on the first run.
  -- The coverage column is COVERAGE_IND {Med+Rx, Rx Only, Med Only}, NOT a Y/N
  -- flag. Medical coverage is Med+Rx OR Med Only; Rx Only is pharmacy-only and
  -- does not satisfy a MEDICAL enrolment criterion.
  SELECT ptid, eligeff, MAX(COALESCE(eligend, DATE'2099-12-31')) AS eligend
  FROM t_clm_co_enrollment_${cut}
  WHERE REPLACE(LOWER(TRIM(coverage_ind)), ' ', '_') IN ('med+rx', 'med_only')
  GROUP BY ptid, eligeff
),
islands AS (
  SELECT ptid, eligeff, eligend,
         CASE WHEN MAX(eligend) OVER (PARTITION BY ptid ORDER BY eligeff
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) IS NULL
                OR DATEDIFF(eligeff, MAX(eligend) OVER (PARTITION BY ptid ORDER BY eligeff
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING)) > 1
              THEN 1 ELSE 0 END AS new_island
  FROM spans
),
stitched AS (
  SELECT ptid, MIN(eligeff) AS eligeff, MAX(eligend) AS eligend
  FROM (SELECT ptid, eligeff, eligend,
               SUM(new_island) OVER (PARTITION BY ptid ORDER BY eligeff
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS island
        FROM islands)
  GROUP BY ptid, island
),
s4 AS (
  SELECT DISTINCT s3.ptid, s3.index_date
  FROM s3 JOIN stitched st USING (ptid), params
  WHERE st.eligeff <= s3.mets_date AND st.eligend >= s3.mets_date
    AND DATEDIFF(s3.mets_date, st.eligeff) >= params.enroll_days
),
-- Step 5 — exclude C25.4 at any observed time.
s5 AS (
  SELECT s4.* FROM s4
  WHERE NOT EXISTS (SELECT 1 FROM dx WHERE dx.ptid = s4.ptid AND dx.cd = 'C254')
),
-- Step 6 — exclude another primary cancer with BOTH dates in [index-180, index].
other_primary AS (
  SELECT s5.ptid
  FROM dx JOIN s5 USING (ptid), params
  WHERE (SUBSTR(dx.cd, 1, 3) RLIKE '^C(0[0-9]|1[0-9]|2[0-4]|2[6-9]|3[0-9]|4[0-3]|4[5-9]|5[0-9]|6[0-9]|7[0-5]|8[1-9]|9[0-7])$'
         -- C76 is a PARTIAL band in the RDQ: C76.0-C76.8, not the whole category.
         OR (SUBSTR(dx.cd, 1, 3) = 'C76' AND SUBSTR(dx.cd, 4, 1) BETWEEN '0' AND '8'))
    AND dx.dt >= DATE_SUB(s5.index_date, params.baseline_days)
    AND dx.dt <= s5.index_date
  GROUP BY s5.ptid
  HAVING COUNT(DISTINCT dx.dt) >= 2
     AND DATEDIFF(MAX(dx.dt), MIN(dx.dt)) > (SELECT visit_gap FROM params)
),
s6 AS (SELECT s5.* FROM s5 WHERE ptid NOT IN (SELECT ptid FROM other_primary)),
-- Step 7 — first daraxonrasib order in the study period (claims: a PAID fill or
-- a medical service line is the only observable proxy for an order).
darax AS (
  SELECT ptid, MIN(dt) AS darax_date FROM (
    SELECT ptid, fill_dt AS dt FROM t_clm_rx_${cut}
    WHERE transaction_type = 'PAID'
      AND (UPPER(COALESCE(brnd_nm,'') || ' ' || COALESCE(gnrc_nm,''))
             RLIKE 'DARAXONRASIB|DARAXON|RASONQUE|RMC.?0?70?6236'
           OR ndc LIKE '85219%')
    UNION ALL
    SELECT ptid, fst_dt FROM t_clm_med_services_${cut}
    WHERE ndc LIKE '85219%'
  ) x, params
  WHERE dt >= params.study_start AND dt <= params.ceiling_dt
  GROUP BY ptid
),
s7 AS (SELECT s6.ptid FROM s6 JOIN darax USING (ptid))
SELECT '1. Adults >=18, Market Clarity'                     AS step, COUNT(*) AS n FROM s1
UNION ALL SELECT '2. Pancreatic cancer (>=2 visits >30d)',        COUNT(*) FROM s2c
UNION ALL SELECT '3. Metastatic disease (>=2 dates, C77-C79.89)', COUNT(*) FROM s3
UNION ALL SELECT '4. >=183d coverage before first metastasis',    COUNT(*) FROM s4
UNION ALL SELECT '5. Exclude C25.4',                              COUNT(*) FROM s5
UNION ALL SELECT '6. Exclude other primary cancer',               COUNT(*) FROM s6
UNION ALL SELECT '7. Daraxonrasib order',                         COUNT(*) FROM s7;



-- ===========================================================================
-- 7. THE REMAINING UNVERIFIED VALUE DOMAINS — all on the EHR / Enriched
--    Oncology surfaces, none of them reachable in a claims-only run.
--
--    Three delivered filters have now been wrong in the same way: a literal
--    taken from the data dictionary that the warehouse does not store
--    (medical_coverage_ind = 'Y'; coverage_ind IN ('med','med+rx');
--    data_source = 'rx_admin'). Each matched nothing and each produced a clean
--    zero rather than an error. The literals below are the ones that have still
--    never been compared against the data, so they carry that same risk.
--
--    This is ONE query returning one grid: surface, column, value, n. Read it
--    as "does the value my code filters on actually appear, and how often".
--    Anything the R code asserts that is missing from this grid is a filter
--    matching nothing.
--
--    OPTIONAL for the current deliverable. The RDQ specifies claims, so
--    RDQ2_PRIMARY_COHORT = "claims" and nothing here is on that path. Run it
--    before quoting any EHR / EO number.
-- ===========================================================================
SELECT * FROM (
  SELECT 't_diagnosis' AS surface, 'diagnosis_cd_type' AS col,
         CAST(diagnosis_cd_type AS STRING) AS val, COUNT(*) AS n
  FROM t_diagnosis_${cut} GROUP BY diagnosis_cd_type
  UNION ALL
  SELECT 't_onc_neoplasm_histology', 'neoplasm_qualifier',
         CAST(neoplasm_qualifier AS STRING), COUNT(*)
  FROM t_onc_neoplasm_histology_${cut} GROUP BY neoplasm_qualifier
  UNION ALL
  SELECT 't_onc_neoplasm_histology', 'histology_qualifier',
         CAST(histology_qualifier AS STRING), COUNT(*)
  FROM t_onc_neoplasm_histology_${cut} GROUP BY histology_qualifier
  UNION ALL
  SELECT 't_onc_metastatic_location', 'mets_qualifier',
         CAST(mets_qualifier AS STRING), COUNT(*)
  FROM t_onc_metastatic_location_${cut} GROUP BY mets_qualifier
  UNION ALL
  SELECT 't_onc_metastatic_location', 'mets_temporal_status',
         CAST(mets_temporal_status AS STRING), COUNT(*)
  FROM t_onc_metastatic_location_${cut} GROUP BY mets_temporal_status
  UNION ALL
  -- Stage is matched on a LEADING CHARACTER, so only the first char matters.
  SELECT 't_onc_stage', 'substr(lower(stage),1,3)',
         SUBSTR(LOWER(stage), 1, 3), COUNT(*)
  FROM t_onc_stage_${cut} GROUP BY SUBSTR(LOWER(stage), 1, 3)
  UNION ALL
  SELECT 't_onc_tnm', 'substr(m,1,1)', SUBSTR(LOWER(m), 1, 1), COUNT(*)
  FROM t_onc_tnm_${cut} GROUP BY SUBSTR(LOWER(m), 1, 1)
  UNION ALL
  SELECT 't_onc_tnm', 'substr(t,1,1)', SUBSTR(LOWER(t), 1, 1), COUNT(*)
  FROM t_onc_tnm_${cut} GROUP BY SUBSTR(LOWER(t), 1, 1)
  UNION ALL
  -- QC strata only; these do not gate the cohort.
  SELECT 't_patient', 'integrated', CAST(integrated AS STRING), COUNT(*)
  FROM t_patient_${cut} GROUP BY integrated
  UNION ALL
  SELECT 't_patient', 'eligibility', CAST(eligibility AS STRING), COUNT(*)
  FROM t_patient_${cut} GROUP BY eligibility
) x
WHERE n > 0
ORDER BY surface, col, n DESC;

-- Does t_diagnosis store the ICD-10 decimal point? The R code now strips it
-- either way (REPLACE is a no-op on un-dotted values), so this only confirms
-- which convention is in force -- it is no longer load-bearing.
SELECT SUM(CASE WHEN diagnosis_cd LIKE '%.%' THEN 1 ELSE 0 END) AS n_dotted,
       SUM(CASE WHEN diagnosis_cd LIKE '%.%' THEN 0 ELSE 1 END) AS n_undotted
FROM t_diagnosis_${cut};
