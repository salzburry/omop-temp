# =============================================================================
# 00_discover.R : EC RDQ303944 - what is in the Flatiron Advanced Endometrial schema
# =============================================================================
# Run once, set up the same way as the LA-HNSCC RDQ (DSN RWDE, DATABRICKS_PWD
# set), from the project root:
#
#   source("R/00_discover.R")
#
# Writes ec_discovery_<DDMONYYYY>.xlsx to out_dir: schemas, tables, columns,
# value lists, date ranges, chemotherapy drug names, cross-tabulations and
# patient counts. Nothing patient-level leaves the database: a column's values
# are listed only when it has at most max_levels distinct values (so patient
# IDs, dates and free text never are), and counts from 1 to min_cell - 1 are
# shown as "<5". A query that fails is logged on the Errors sheet; the run
# carries on.
# =============================================================================

suppressPackageStartupMessages({ library(DBI); library(dplyr); library(openxlsx) })

# ---- Parameters (edit here) -----------------------------------------------------------
catalog        <- "hive_metastore"
schema         <- NULL                 # NULL: the one schema matching schema_pattern
schema_pattern <- "*endo*|*edm*"       # SHOW SCHEMAS LIKE: * is a wildcard, | separates patterns
refresh        <- NULL                 # NULL: the latest _<yyyy>m<mm> table suffix, e.g. "2026m10"
expected_n     <- 8114                 # "Full Flatiron Database" N in the RDQ shell
max_levels     <- 50                   # list a column's values only up to this many distinct values
min_cell       <- 5                    # counts below this are masked; 0 = no masking
out_dir        <- "/mnt/artifacts/results"
out_file       <- file.path(out_dir, paste0("ec_discovery_", toupper(format(Sys.Date(), "%d%b%Y")), ".xlsx"))

# RDQ chemotherapy list. The stems also catch paclitaxel protein-bound and
# doxorubicin pegylated liposomal; brand names in case a name column holds them.
chemo_re <- paste0("carboplatin|paclitaxel|docetaxel|cisplatin|gemcitabine|doxorubicin|ifosfamide|",
                   "capecitabine|topotecan|mitomycin|abraxane|doxil|caelyx")

# Table roles, matched on the lower-case table name without the _<refresh>
# suffix (GSK renames tables on load). A table may take several roles and a
# role several tables: every table with a role is profiled.
roles <- c(cohort       = "enh.*(endo|edm)",       # Enhanced_AdvEndometrial and its companions
           biomarker    = "bio|bmk",               # MMR / MSI results
           lot          = "line.*ther|(^|_)lot(_|$)",
           drugepisode  = "dr?u?g_?ep",
           demographics = "demog",
           setting      = "adjuv|early")           # any separate adjuvant / early-line table

# Cross-tabulations: for a table with this role, the first (up to 3) listable
# columns whose names match these patterns, in this order.
xt_pats <- list(lot       = c("setting", "mainten", "line_?num"),
                setting   = c("setting", "mainten", "line_?num"),
                biomarker = c("name", "status", "test|method"))

# ---- Connection ---------------------------------------------------------------------
pwd <- Sys.getenv("DATABRICKS_PWD")
if (!nzchar(pwd)) stop("Set the DATABRICKS_PWD environment variable.", call. = FALSE)
con <- dbConnect(odbc::odbc(), dsn = "RWDE", pwd = pwd, timeout = 120, bigint = "numeric")
invisible(dbExecute(con, paste("USE CATALOG", catalog)))

errors <- tibble(step = character(), sql = character(), error = character())
q <- function(sql, step) tryCatch(dbGetQuery(con, sql), error = function(e) {
  errors <<- bind_rows(errors, tibble(step = step, sql = sql, error = conditionMessage(e)))
  NULL
})
bq   <- function(x) paste0("`", x, "`")
fq   <- function(t) paste0(schema, ".", bq(t))
pick <- function(cols, pats)
  head(unique(unlist(lapply(pats, function(p) grep(p, cols, value = TRUE, ignore.case = TRUE)))), 3)

# ---- Schema and refresh ---------------------------------------------------------------
flatiron_schemas <- tryCatch(sort(dbGetQuery(con, "SHOW SCHEMAS LIKE '*flatiron*'")[[1]]),
                             error = function(e) character())
if (is.null(schema)) {
  hits <- dbGetQuery(con, paste0("SHOW SCHEMAS LIKE '", schema_pattern, "'"))[[1]]
  if (length(hits) != 1)
    stop(length(hits), " schemas match '", schema_pattern, "': ", paste(hits, collapse = ", "),
         "\nSet `schema` in 00_discover.R. Flatiron schemas:\n  ",
         paste(flatiron_schemas, collapse = "\n  "), call. = FALSE)
  schema <- hits
}

all_tabs  <- dbGetQuery(con, paste("SHOW TABLES IN", schema))$tableName
sfx_re    <- "_([0-9]{4}m[0-9]{2})$"
sfx       <- ifelse(grepl(sfx_re, tolower(all_tabs)), sub(paste0(".*", sfx_re), "\\1", tolower(all_tabs)), NA)
refreshes <- sort(unique(na.omit(sfx)))
if (is.null(refresh)) refresh <- if (length(refreshes)) tail(refreshes, 1) else NA
refresh   <- tolower(refresh)
tabs      <- if (is.na(refresh)) all_tabs else all_tabs[sfx %in% refresh]
if (!length(tabs))
  stop("No tables in ", schema, " for refresh ", refresh, ". Refreshes found: ",
       paste(refreshes, collapse = ", "), call. = FALSE)
stems <- if (is.na(refresh)) tolower(tabs) else sub(paste0("_", refresh, "$"), "", tolower(tabs))

role_of <- vapply(stems, function(s) paste(names(roles)[vapply(roles, grepl, logical(1), x = s)],
                                           collapse = ", "), "")
cat("Schema:", schema, " Refresh:", refresh, " Tables:", length(tabs), "\n")

# ---- Tables and columns ---------------------------------------------------------------
tables <- tibble(table = tabs, stem = stems, role = unname(role_of),
                 n_rows = unname(vapply(tabs, function(t) {
                   r <- q(paste("SELECT count(*) AS n FROM", fq(t)), paste("count", t))
                   if (is.null(r)) NA_real_ else as.numeric(r$n)
                 }, numeric(1))),
                 n_patients = NA_real_)
cat("Tables with a role:\n")
print(as.data.frame(filter(tables, nzchar(role))[c("table", "role", "n_rows")]), row.names = FALSE)

describe <- function(t) {
  d <- q(paste("DESCRIBE TABLE", fq(t)), paste("describe", t))
  if (is.null(d)) return(NULL)
  d <- d[!is.na(d$col_name) & nzchar(trimws(d$col_name)) & !startsWith(d$col_name, "#"),
         c("col_name", "data_type")]
  distinct(tibble(table = t, column = d$col_name, type = d$data_type))   # partition columns repeat
}
columns <- bind_rows(lapply(tabs, describe))
if (!nrow(columns)) stop("DESCRIBE failed for every table. First error: ", errors$error[1], call. = FALSE)

# ---- Profile every table with a role --------------------------------------------------
profile <- list(); values <- list(); dates <- list(); drugs <- list(); xtabs <- list()
prof_tabs <- tables$table[nzchar(tables$role)]

for (t in prof_tabs) {
  message("Profiling ", t)
  cl <- filter(columns, table == t, !grepl("^(array|map|struct)", tolower(type)))
  if (!nrow(cl)) next
  pid     <- cl$column[tolower(cl$column) == "patientid"][1]
  pid_sql <- if (is.na(pid)) "" else paste0(", count(DISTINCT ", bq(pid), ") AS n_patients")
  k       <- seq_len(nrow(cl))

  # One pass: patients, and each column's distinct values and missing count
  ex <- c(if (is.na(pid)) "CAST(NULL AS BIGINT) AS n_patients"
          else paste0("count(DISTINCT ", bq(pid), ") AS n_patients"),
          paste0("approx_count_distinct(", bq(cl$column), ") AS d", k),
          paste0("sum(CASE WHEN ", bq(cl$column), " IS NULL THEN 1 ELSE 0 END) AS m", k))
  r <- q(paste("SELECT", paste(ex, collapse = ", "), "FROM", fq(t)), paste("profile", t))
  if (is.null(r)) next
  tables$n_patients[tables$table == t] <- as.numeric(r$n_patients)
  cl <- mutate(cl,
               n_distinct_approx = as.numeric(unlist(r[1, paste0("d", k)])),
               n_missing         = as.numeric(unlist(r[1, paste0("m", k)])),
               is_date = grepl("^(date|timestamp)", tolower(type)) | grepl("date$", tolower(column)))
  profile[[t]] <- select(cl, table, column, n_distinct_approx, n_missing)

  # Date ranges (string dates too); n_not_a_date counts values that do not
  # parse as a full date, e.g. month-only "2021-03"
  dc <- cl$column[cl$is_date]
  if (length(dc)) {
    j  <- seq_along(dc)
    ex <- c(paste0("CAST(min(try_cast(", bq(dc), " AS DATE)) AS STRING) AS lo", j),
            paste0("CAST(max(try_cast(", bq(dc), " AS DATE)) AS STRING) AS hi", j),
            paste0("sum(CASE WHEN ", bq(dc), " IS NOT NULL AND try_cast(", bq(dc),
                   " AS DATE) IS NULL THEN 1 ELSE 0 END) AS u", j))
    r <- q(paste("SELECT", paste(ex, collapse = ", "), "FROM", fq(t)), paste("dates", t))
    if (!is.null(r))
      dates[[t]] <- tibble(table = t, column = dc,
                           min = as.character(unlist(r[1, paste0("lo", j)])),
                           max = as.character(unlist(r[1, paste0("hi", j)])),
                           n_not_a_date = as.numeric(unlist(r[1, paste0("u", j)])))
  }

  # Value lists of low-cardinality columns (never the patient ID, dates or free text)
  lc <- filter(cl, !is_date, !is.na(n_distinct_approx), n_distinct_approx > 0,
               n_distinct_approx <= max_levels, is.na(pid) | column != pid)
  for (cn in lc$column) {
    r <- q(paste0("SELECT CAST(", bq(cn), " AS STRING) AS value, count(*) AS n_rows", pid_sql,
                  " FROM ", fq(t), " GROUP BY 1 ORDER BY n_rows DESC LIMIT ", 2 * max_levels),
           paste("values", t, cn))
    if (!is.null(r))
      values[[paste(t, cn)]] <- tibble(table = t, column = cn, value = r$value, n_rows = as.numeric(r$n_rows),
                                       n_patients = if (is.na(pid)) NA_real_ else as.numeric(r$n_patients))
  }

  # Drug and line names that contain an RDQ chemotherapy
  for (cn in cl$column[grepl("(drug|line|regimen|agent)_?name|regimen", tolower(cl$column))]) {
    r <- q(paste0("SELECT ", bq(cn), " AS value, count(*) AS n_rows", pid_sql, " FROM ", fq(t),
                  " WHERE lower(", bq(cn), ") RLIKE '", chemo_re, "' GROUP BY 1 ORDER BY n_rows DESC LIMIT 500"),
           paste("chemo names", t, cn))
    if (!is.null(r) && nrow(r))
      drugs[[paste(t, cn)]] <- tibble(table = t, column = cn, value = r$value, n_rows = as.numeric(r$n_rows),
                                      n_patients = if (is.na(pid)) NA_real_ else as.numeric(r$n_patients))
  }

  # Cross-tabulations: LOT setting x maintenance x line number; biomarker name x status x test
  for (rl in intersect(strsplit(tables$role[tables$table == t], ", ")[[1]], names(xt_pats))) {
    xc <- pick(lc$column, xt_pats[[rl]])
    if (length(xc) < 2) next
    v  <- paste0("v", seq_along(xc))
    r  <- q(paste0("SELECT ", paste0("CAST(", bq(xc), " AS STRING) AS ", v, collapse = ", "),
                   ", count(*) AS n_rows", pid_sql, " FROM ", fq(t),
                   " GROUP BY ", paste(seq_along(xc), collapse = ", "), " ORDER BY n_rows DESC LIMIT 500"),
            paste("crosstab", t))
    if (!is.null(r))
      xtabs[[paste(t, paste(xc, collapse = "|"))]] <- tibble(
        table = t, columns = paste(xc, collapse = " x "),
        values = do.call(paste, c(lapply(r[v], function(x) coalesce(x, "<missing>")), sep = " | ")),
        n_rows = as.numeric(r$n_rows), n_patients = if (is.na(pid)) NA_real_ else as.numeric(r$n_patients))
  }
}

# ---- Checks ---------------------------------------------------------------------------
checks <- tables %>% filter(grepl("cohort|demographics", role)) %>%
  transmute(table, role, n_rows, n_patients,
            one_row_per_patient = n_rows == n_patients,
            matches_rdq_n       = n_patients == expected_n)

# ---- Output ---------------------------------------------------------------------------
mask  <- function(n) ifelse(is.na(n), NA_character_,
                            ifelse(n > 0 & n < min_cell, paste0("<", min_cell),
                                   format(n, scientific = FALSE, trim = TRUE)))
cells <- function(d) mutate(d, across(any_of(c("n_rows", "n_patients", "n_missing", "n_not_a_date")), mask))
stack <- function(l) if (length(l)) cells(bind_rows(l)) else tibble(note = "nothing found")

prof_df <- if (length(profile)) bind_rows(profile) else
  tibble(table = character(), column = character(), n_distinct_approx = numeric(), n_missing = numeric())
run <- tibble(item  = c("catalog", "schema", "refresh used", "refreshes in schema", "tables for refresh",
                        "tables profiled", "expected N (RDQ shell)", "max_levels", "min_cell", "run date"),
              value = c(catalog, schema, refresh, paste(refreshes, collapse = ", "), length(tabs),
                        length(prof_tabs), expected_n, max_levels, min_cell, format(Sys.Date())))
sheets <- list(Run           = run,
               Schemas       = tibble(flatiron_schema = flatiron_schemas),
               Tables        = cells(tables),
               Columns       = cells(left_join(columns, prof_df, by = c("table", "column"))),
               Values        = stack(values),
               Dates         = stack(dates),
               `Chemo names` = stack(drugs),
               Crosstabs     = stack(xtabs),
               Checks        = cells(checks),
               Errors        = if (nrow(errors)) errors else tibble(note = "no failed queries"))

dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
wb <- createWorkbook()
for (s in names(sheets)) {
  d <- sheets[[s]]
  if (!ncol(d)) d <- tibble(note = "nothing found")
  addWorksheet(wb, s)
  writeData(wb, s, d)
  freezePane(wb, s, firstRow = TRUE)
  setColWidths(wb, s, cols = seq_len(ncol(d)), widths = "auto")
}
saveWorkbook(wb, out_file, overwrite = TRUE)
dbDisconnect(con)

cat("\nChecks:\n"); print(as.data.frame(checks), row.names = FALSE)
if (nrow(errors)) cat("\n", nrow(errors), "queries failed - see the Errors sheet.\n")
cat("\nWrote", out_file, "\n")
