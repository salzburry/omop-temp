# ---- Chemotherapy date check (diagnostic only; Table 1 unchanged) ---------------------
# First-course chemo episodes against the radiation window, and how many chemo
# "Yes" patients a date window would change.
chk <- drugs %>% filter(first, chemo, patientid %in% ids) %>% left_join(fc_end, by = "patientid") %>%
  mutate(ep = as.Date(episodedate),
         position = case_when(is.na(ep) ~ "No episode date",
                              !is.na(fc_end) & ep >= fc_end ~ "After end of first course",
                              is.na(dx_date) ~ "No diagnosis date",
                              ep < dx_date - rt_lookback_days ~ "Before window",
                              TRUE ~ "Inside window"))
chk_pat <- chk %>% group_by(patientid) %>%
  summarise(inside = any(position == "Inside window"), undated = any(grepl("^No ", position)))
chemo_check <- bind_rows(
  count(chk, line_setting = toupper(norm(linesetting)), position, name = "n"),
  tibble(position = c("Chemo Yes patients", "Would change to No/Unknown under a date window",
                      "Cannot be placed (missing date)"),
         n = c(nrow(chk_pat), sum(!chk_pat$inside & !chk_pat$undated), sum(!chk_pat$inside & chk_pat$undated))))
print(as.data.frame(chemo_check), row.names = FALSE)

