# =============================================================================
# find_tables.R : where is MarketScan on Databricks? (prints only)
# =============================================================================
# Run on the platform with DATABRICKS_PWD set, from the cml_tki_rdq folder:
#   Rscript find_tables.R                      catalogs, and the schemas of hive_metastore
#   Rscript find_tables.R <catalog>            the schemas of that catalog
#   Rscript find_tables.R <catalog>.<schema>   the tables of that schema, with the columns
#                                              of the MarketScan-like ones
# Schemas and tables whose names look like MarketScan are listed first.
# Fill in catalog, ms_schema and the table names at the top of cml_tki_rdq.R from the output.
# =============================================================================
suppressPackageStartupMessages(library(DBI))
schema_pat <- "marketscan|merative|truven|ccae|mdcr|mktscan|ibm"
table_pat  <- "ccae|mdcr|redbook|red_book|enrol|outpat|inpat|serv|drug|pharm"

pwd <- Sys.getenv("DATABRICKS_PWD")
if (!nzchar(pwd)) stop("Set the DATABRICKS_PWD environment variable.", call. = FALSE)
con <- dbConnect(odbc::odbc(), dsn = "RWDE", pwd = pwd, timeout = 120, bigint = "numeric")
show <- function(title, x) { cat("\n", title, " (", length(x), "):\n", sep = ""); if (length(x)) cat(paste0("  ", x), sep = "\n") }

arg <- c(commandArgs(trailingOnly = TRUE), "hive_metastore")[1]
catalog <- sub("\\..*$", "", arg)
schema  <- if (grepl("\\.", arg)) sub("^[^.]*\\.", "", arg) else NA
if (is.na(schema)) {
  cat_list <- tryCatch(dbGetQuery(con, "SHOW CATALOGS")[[1]], error = function(e) paste("SHOW CATALOGS failed:", conditionMessage(e)))
  show("Catalogs", sort(cat_list))
  invisible(dbExecute(con, paste("USE CATALOG", catalog)))
  s <- sort(dbGetQuery(con, "SHOW SCHEMAS")[[1]])
  show(paste0("Schemas in ", catalog, " that look like MarketScan"), grep(schema_pat, s, ignore.case = TRUE, value = TRUE))
  show(paste("All schemas in", catalog), s)
} else {
  invisible(dbExecute(con, paste("USE CATALOG", catalog)))
  tabs <- dbGetQuery(con, paste("SHOW TABLES IN", schema))
  tab  <- sort(tabs[[grep("tablename", tolower(names(tabs)))[1]]])
  like <- grep(table_pat, tab, ignore.case = TRUE, value = TRUE)
  show(paste0("Tables in ", schema, " that look like MarketScan"), like)
  show(paste("All tables in", schema), tab)
  for (t in like) {
    x <- dbGetQuery(con, paste0("SELECT * FROM ", schema, ".", t, " LIMIT 1"))
    cat("\n== ", t, " ==\n", paste0(tolower(names(x)), " <", vapply(x, function(v) class(v)[1], ""), ">", collapse = ", "), "\n", sep = "")
  }
}
dbDisconnect(con)

