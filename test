--
-- THE THREE QUESTIONS LEFT AFTER 04, plus one that 04's own screenshots raised.
-- Short: everything here is a frequency count or a DESCRIBE, and the whole run
-- should take minutes rather than the 1h 20m that 04 took.
--
--   PART A  Is there a TERSE ECOG literal in t_observation that 04 missed?
--   PART B  Does performance status live in t_onc_evaluation_system instead?
--   PART C  What are t_pat_obs_time's varchar(1) flag values, and is there
--           anything called coverage_ind anywhere?
--   PART D  Which table-name suffix is current -- 2025q4 or 2026q1?
--
-- WHY A IS NOT JUST "RE-READ THE 04 OUTPUT". It could be, and if you still have
-- the full 122-row A2 result set then A1 below is redundant -- say so and skip
-- it. But A2 is a genuinely different instrument and is the point of this file:
-- it finds a performance status BY THE SHAPE OF ITS VALUES rather than by its
-- name, so it works even if Optum calls the column something nobody would
-- think to grep for.
--
-- THE MISTAKE THIS FILE EXISTS TO CORRECT was mine. 04's targeted probe searched
-- ENGLISH WORDS -- ecog, performance, karnofsky, kps -- and reported no
-- performance status in t_observation. The same probe, in the same table, also
-- missed SBP, DBP, WT and HT: the four highest-volume vitals in the deployment,
-- invisible because Optum uses terse codes and the patterns were prose. I wrote
-- that lesson down and then let the ECOG conclusion stand on the probe that
-- taught it. 'Not matched by my regex' is not 'not present'.

USE hive_metastore.clnprw_optum_mc_full_use;

-- Same lung denominator as 01 and 04, repeated verbatim so this file runs on
-- its own and cannot disagree with them about who has lung cancer.
CREATE OR REPLACE TEMPORARY VIEW lung AS
SELECT DISTINCT ptid
FROM   t_diagnosis_2025q4
WHERE  (diagnosis_cd_type = 'ICD10' AND diagnosis_cd LIKE 'C34%')
    OR (diagnosis_cd_type = 'ICD9'  AND diagnosis_cd RLIKE '^162'
        AND NOT diagnosis_cd RLIKE '^1620');


-- ###########################################################################
-- PART A - is there a terse ECOG literal in t_observation?
-- ###########################################################################

-- A1. THE COMPLETE OBS_TYPE LIST. 122 rows, and this time SAVE ALL OF THEM --
--     04 returned this same list and only its top rows were transcribed, which
--     is the whole reason the question is still open. No LIMIT, no ORDER BY
--     patient count: alphabetical, so the tail is as readable as the head and
--     nobody stops scrolling at the interesting part.
--     Skip this query if you still have 04's A2 output in full.
SELECT DISTINCT o.obs_type
FROM   t_observation_2025q4 o
JOIN   lung l ON l.ptid = o.ptid
ORDER  BY o.obs_type;

-- A2. ****** THE ONE THAT ACTUALLY SETTLES IT ******
--     Find a performance status BY THE SHAPE OF ITS VALUES, not by its name.
--     ECOG is a small integer 0-4 (0-5 per the Enriched Oncology manual p.4)
--     and nothing else. So: every type whose values are ALL single digits 0-5,
--     whatever it is called. A column named PERF, PS, FUNC_STAT or PS_SCORE is
--     caught by this and by no name-based probe.
--
--     The pain score is 0-10 and will not qualify; a 0/1 flag will, which is
--     why n_distinct and the sample are returned -- two values is a flag, five
--     or six is a scale.
SELECT o.obs_type,
       o.nlp,
       o.obs_unit,
       COUNT(*)                     AS n_rows,
       COUNT(DISTINCT o.ptid)       AS n_patients,
       COUNT(DISTINCT o.obs_result) AS n_distinct_values,
       CONCAT_WS(' | ', SORT_ARRAY(COLLECT_SET(o.obs_result))) AS all_values
FROM   t_observation_2025q4 o
JOIN   lung l ON l.ptid = o.ptid
WHERE  o.obs_result IS NOT NULL AND o.obs_result <> ''
GROUP  BY o.obs_type, o.nlp, o.obs_unit
HAVING COUNT(DISTINCT o.obs_result) <= 8
   -- every observed value is a bare 0-5, with or without a trailing .0
   AND MAX(CASE WHEN o.obs_result RLIKE '^[0-5](\\.0+)?$' THEN 0 ELSE 1 END) = 0
ORDER  BY n_patients DESC;

-- A3. The same shape test on t_nlp_measure, as a control. ECOG is KNOWN to be
--     there (MEASUREMENT_TYPE = 'ECOG', 54,231 patients), so this query MUST
--     return it. If it does not, the shape test is broken and A2's silence
--     means nothing -- which is the failure mode a control exists to catch.
SELECT m.measurement_type,
       COUNT(*)                           AS n_rows,
       COUNT(DISTINCT m.ptid)             AS n_patients,
       COUNT(DISTINCT m.measurement_value) AS n_distinct_values,
       CONCAT_WS(' | ', SORT_ARRAY(COLLECT_SET(m.measurement_value))) AS all_values
FROM   t_nlp_measure_2025q4 m
JOIN   lung l ON l.ptid = m.ptid
WHERE  m.measurement_value IS NOT NULL AND m.measurement_value <> ''
GROUP  BY m.measurement_type
HAVING COUNT(DISTINCT m.measurement_value) <= 8
   AND MAX(CASE WHEN m.measurement_value RLIKE '^[0-5](\\.0+)?$' THEN 0 ELSE 1 END) = 0
ORDER  BY n_patients DESC;


-- ###########################################################################
-- PART B - t_onc_evaluation_system: grading, or performance status?
-- ###########################################################################
--
-- TWO VENDOR DOCUMENTS CONTRADICT EACH OTHER. The Enriched Oncology manual p.16
-- states performance status is in the Evaluation_System table; the dictionary
-- index and its column sheet describe that table as tumour GRADING (Nottingham
-- components, Gleason). optum_capability_inventory.md finding 10 flags this
-- explicitly and says not to close the table for ECOG on the column sheet
-- alone. It is in the deployment (rdq_query_outputs/data sources.txt).

-- B0. Columns first -- this table has no live DESCRIBE anywhere in the repo.
DESCRIBE TABLE t_onc_evaluation_system_2025q4;

-- B1. The system vocabulary. If ECOG or Karnofsky appears here, the manual is
--     right and the dictionary is describing only part of the table.
--     Column names are from the dictionary and are UNVERIFIED -- if B0 shows
--     something different, fix them here and say so in the results note.
SELECT e.system_name,
       COUNT(*)               AS n_rows,
       COUNT(DISTINCT e.ptid) AS n_patients
FROM   t_onc_evaluation_system_2025q4 e
JOIN   lung l ON l.ptid = e.ptid
GROUP  BY e.system_name
ORDER  BY n_patients DESC;


-- ###########################################################################
-- PART C - t_pat_obs_time: the flag vocabulary, and the coverage_ind question
-- ###########################################################################
--
-- The DESCRIBE is already recorded (results/2026-09-03_pat_obs_time_describe.md):
-- 14 columns, monthly grid on ACTIVITY_YYYYMM, and the observability instrument
-- is CLM_RX_ENROLL / CLM_MED_ENROLL rather than the *_ACTIVITY flags. What is
-- NOT known is what the varchar(1) columns actually contain.

-- C1. THE FLAG VOCABULARY. Presumably Y/N -- but t_lab.VALUE_WITHIN_RANGE is
--     Y/N/U in this same deployment, so a third value is not unprecedented, and
--     a 'U' silently read as 'N' marks OBSERVED months unobserved. That error
--     runs in the direction that shortens follow-up, which is the direction
--     that changes an rwOS estimate.
SELECT any_clinical_activity,
       clm_med_enroll,
       clm_rx_enroll,
       encounter_activity,
       COUNT(*)               AS n_rows,
       COUNT(DISTINCT t.ptid) AS n_patients
FROM   t_pat_obs_time_2025q4 t
JOIN   lung l ON l.ptid = t.ptid
GROUP  BY 1, 2, 3, 4
ORDER  BY n_rows DESC
LIMIT  100;

-- C2. IS THERE A coverage_ind ANYWHERE? It was named as the coverage flag and
--     t_pat_obs_time does not have it, so either it is on a different table or
--     the name came from somewhere else. This asks the catalogue rather than
--     guessing which of the two *_ENROLL columns was meant -- picking one
--     silently is how the wrong flag ends up driving censoring.
SELECT table_name, column_name, data_type
FROM   information_schema.columns
WHERE  table_schema = 'clnprw_optum_mc_full_use'
   AND LOWER(column_name) LIKE '%coverage%'
ORDER  BY table_name, column_name;

-- C3. The observable window per patient, which is what censoring needs and what
--     no table in this deployment supplies ready-made. Reported as enrolment
--     months, NOT activity months -- see the results note for why the two are
--     different instruments.
SELECT COUNT(DISTINCT t.ptid)                                   AS n_lung_on_roster,
       MIN(t.activity_yyyymm)                                   AS earliest_month,
       MAX(t.activity_yyyymm)                                   AS latest_month,
       ROUND(AVG(CASE WHEN t.clm_med_enroll = 'Y' THEN 1.0 ELSE 0.0 END), 3)
                                                                AS pct_months_med_enrolled
FROM   t_pat_obs_time_2025q4 t
JOIN   lung l ON l.ptid = t.ptid;


-- ###########################################################################
-- PART D - which cut are we reading?
-- ###########################################################################
--
-- The t_pat_obs_time DESCRIBE was run against a 2026q1 suffix -- its own comment
-- says "CUT SUFFIX: hardcoded as 2026q1 on purpose". EVERY table reference in
-- this repository is _2025q4: the R readers, all five SQL files, and
-- optum_table_inventory.csv. If the deployment has moved, then the inventory's
-- column and vocabulary findings were verified against a cut we are no longer
