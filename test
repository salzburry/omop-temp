build_mock <- function(n = 400, seed = 20261104) {
  set.seed(seed)
  con <- dbConnect(SQLite(), ":memory:")
  invisible(dbExecute(con, "ATTACH ':memory:' AS clnprw_flatiron_la_hnc_use"))
  put <- function(name, df) dbWriteTable(con, Id(schema = "clnprw_flatiron_la_hnc_use",
                                                table = paste0(name, "_2026m07")), df)
  ids <- sprintf("P%04d", 1:n)
  dx  <- as.Date("2018-06-01") + sample(0:(365 * 5), n, TRUE)
  adv <- ifelse(runif(n) < .3, as.character(dx + sample(200:900, n, TRUE)), NA)

  coh <- data.frame(
    PatientID = ids, DiagnosisDate = as.character(dx), AdvancedDiagnosisDate = adv,
    AdvancedDiagnosisCriteria = ifelse(is.na(adv), NA, "Distant recurrence"),
    GroupStage  = sample(c("III", "IV", "IVA", "IVB", "Unknown/not documented"), n, TRUE),
    PrimarySite = sample(c("Oral cavity", "Oropharynx", "Hypopharynx", "Larynx", "Pharynx NOS",
                           "Tongue NOS", "Unknown primary Head & Neck cancer"), n, TRUE),
    SmokingStatus = sample(c("History of smoking", "No history of smoking"), n, TRUE),
    HPVTested = sample(c("Yes", "No/unknown"), n, TRUE),
    HPVStatus = sample(c("HPV positive", "HPV negative", "HPV equivocal", "Results pending", NA), n, TRUE))
  dxr <- data.frame(PatientID = ids,
    DiagnosisCode = sample(c("C01", "C10.9", "C32.1", "C11.9", "C12", "146.0", "147.1", "C07", "C30.0", "C77.0"),
                           n, TRUE, prob = c(.3, .25, .2, .04, .05, .05, .03, .03, .03, .02))) %>%
    mutate(DiagnosisCodeSystem = ifelse(grepl("^C", DiagnosisCode), "ICD-10-CM", "ICD-9-CM"))
  demo <- data.frame(PatientID = ids,
    BirthSex = sample(c("M", "F", NA), n, TRUE, prob = c(.74, .25, .01)),
    BirthYear = sample(c(1935:2004, NA), n, TRUE),
    Race = sample(c("White", "Black or African American", "Asian", "Other Race",
                    "Hispanic or Latino", NA), n, TRUE, prob = c(.6, .1, .05, .1, .05, .1)),
    Ethnicity = sample(c("Not Hispanic or Latino", "Hispanic or Latino", NA), n, TRUE))
  prac <- data.frame(PatientID = sample(ids, n * 1.3, TRUE),
    PracticeType = sample(c("COMMUNITY", "ACADEMIC"), n * 1.3, TRUE, prob = c(.8, .2))) %>%
    mutate(PracticeID = sprintf("%s%d", substr(PracticeType, 1, 2), seq_along(PatientID) %% 5 + 1))

  s_ids <- sample(ids, n * .8)
  s_types <- c("Primary tumor resection only", "Primary tumor resection and lymph node dissection",
               "Lymph node dissection only", "Unknown/not specified", "Endoscopic mucosal resection")
  surg <- data.frame(PatientID = c(s_ids, sample(s_ids, 40)),
    SurgeryType = sample(s_types, length(s_ids) + 40, TRUE, prob = c(.3, .3, .2, .15, .05)))
  surg$SurgeryDate <- as.character(dx[match(surg$PatientID, ids)] + 30)

  d_ids <- sample(ids, n * .7); nd <- length(d_ids)
  drugs <- data.frame(PatientID = d_ids,
    LineSetting = sample(c("CONCURRENT", "ADJUVANT", "INDUCTION CHEMO", "NEOADJUVANT", "EARLY",
                           "RADIATION THERAPY", "ADVANCED", "LOCOREGIONAL"), nd, TRUE),
    DrugName = sample(c("cisplatin", "carboplatin", "cetuximab", "pembrolizumab", "ondansetron"),
                      nd, TRUE),
    EpisodeDate = as.character(dx[match(d_ids, ids)] + 60))

  r_ids <- sample(ids, n * .7)
  rt <- data.frame(PatientID = r_ids,
    RTStartDate = as.character(dx[match(r_ids, ids)] + sample(-60:400, length(r_ids), TRUE)),
    RTStartDateGranularity = sample(c("Day", "Month", "Year"), length(r_ids), TRUE, prob = c(.9, .05, .05)),
    RTSite = sample(c("Primary site (Includes regional lymph node involvement)",
                      "Distant lymph nodes", "Distant site", NA), length(r_ids), TRUE,
                    prob = c(.7, .1, .1, .1)))
  lr_ids <- sample(ids, n * .1)
  lrec <- data.frame(PatientID = lr_ids, LocalRecurSite = "Local site",
                     LocalRecurDate = as.character(dx[match(lr_ids, ids)] + sample(150:700, length(lr_ids), TRUE)))
  m_ids <- sample(ids, n * .05)
  mrec <- data.frame(PatientID = m_ids,
                     DistantMetDate = as.character(dx[match(m_ids, ids)] + sample(150:700, length(m_ids), TRUE)))
  prac <- distinct(prac)                                  # 0-3 visits per patient-practice, -200 to +400 days
  visit <- prac[rep(seq_len(nrow(prac)), sample(0:3, nrow(prac), TRUE)), c("PatientID", "PracticeID")]
  visit$VisitDate <- as.character(dx[match(visit$PatientID, ids)] + sample(-200:400, nrow(visit), TRUE))

  # ---- fixtures ----
  for (f in fixtures) {
    coh <- rbind(coh, data.frame(PatientID = f$id, DiagnosisDate = f$dx, AdvancedDiagnosisDate = f$adv,
      AdvancedDiagnosisCriteria = NA, GroupStage = f$stage, PrimarySite = "Larynx",
      SmokingStatus = "History of smoking", HPVTested = "Yes", HPVStatus = f$hpv))
    for (dc in f$dx_codes) dxr <- rbind(dxr, data.frame(PatientID = f$id, DiagnosisCode = dc[1],
                                                       DiagnosisCodeSystem = dc[2]))
    demo <- rbind(demo, data.frame(PatientID = f$id, BirthSex = f$birthsex, BirthYear = f$birthyear,
                                   Race = f$race, Ethnicity = f$eth))
    for (v in f$visits) {
      prac <- rbind(prac, data.frame(PatientID = f$id, PracticeType = v[1], PracticeID = paste0("FX_", v[1])))
      if (!is.na(v[2])) visit <- rbind(visit, data.frame(PatientID = f$id, PracticeID = paste0("FX_", v[1]),
                                                         VisitDate = as.character(as.Date(f$dx) + as.numeric(v[2]))))
    }
    for (s in f$surg) surg <- rbind(surg, data.frame(PatientID = f$id, SurgeryType = s, SurgeryDate = f$dx))
    for (d in f$drugs) drugs <- rbind(drugs, data.frame(PatientID = f$id, LineSetting = d[1],
                                                        DrugName = d[2], EpisodeDate = f$dx))
    for (r in f$rt) rt <- rbind(rt, data.frame(PatientID = f$id, RTStartDate = r[1],
                                               RTStartDateGranularity = r[2], RTSite = r[3]))
    if (!is.na(f$localrec)) lrec <- rbind(lrec, data.frame(PatientID = f$id, LocalRecurSite = "Local site",
                                                           LocalRecurDate = f$localrec))
    if (!is.na(f$metrec)) mrec <- rbind(mrec, data.frame(PatientID = f$id, DistantMetDate = f$metrec))
  }
  drugs <- drugs %>% mutate(DrugCategory = drug_cat(DrugName),
                            DetailedDrugCategory = unname(drug_class[DrugName]),
                            EnhancedCohort = "LAHNC")

  put("t_enh_lahnc", coh)
  put("t_diagnosis", dxr)
  put("t_demographics", demo)
  put("t_practice", distinct(prac))
  put("t_visit", mutate(visit, VisitType = "Treatment"))
  put("t_enh_lahnc_primarysurgery", surg)
  put("t_enh_lahnc_drg_epsode", drugs)            # prostate-style GSK rename
  put("t_enh_lahnc_radiationtherapy", rt)
  put("t_enh_lahnc_localrecurrence", lrec)
  put("t_enh_lahnc_metrecurrence", mrec)
  put("t_enh_lahnc_salvagesurgery", data.frame(PatientID = "P0001", SalvageSurgeryType = "Neck Dissection (ND)"))
  con
}

# Run 00 (with the connection and table listing pointed at the mock), then
# 01 and 02, with parameter overrides applied after 00.
run <- function(con, overrides = list(), seer = file.path(mock_dir, "none.csv"), steps = c("01", "02")) {
  s0 <- readLines("R/00_setup.R")
  s0 <- sub("^con <- connect\\(\\)$", "con <- mock_con", s0)
  s0 <- sub("^invisible\\(dbExecute\\(con, paste\\(\"USE CATALOG\", catalog\\)\\)\\)$", "", s0)
  s0 <- sub("^schema_tables <- .*$", paste0("schema_tables <- DBI::dbGetQuery(con, \"SELECT name FROM ",
            "clnprw_flatiron_la_hnc_use.sqlite_master WHERE type = 'table'\")$name"), s0)
  stopifnot(sum(grepl("mock_con|sqlite_master", s0)) == 2)
  assign("mock_con", con, envir = globalenv())
  warns <- character()
  withCallingHandlers({
    capture.output(suppressMessages({
      eval(parse(text = s0), envir = globalenv())
      assign("out_dir", file.path(mock_dir, "out"), envir = globalenv())
      assign("out_stem", "MOCK", envir = globalenv())
      assign("seer_file", seer, envir = globalenv())
      for (nm in names(overrides)) assign(nm, overrides[[nm]], envir = globalenv())
      for (st in steps) sys.source(list.files("R", paste0("^", st, "_"), full.names = TRUE), envir = globalenv())
    }))
  }, warning = function(w) { warns <<- c(warns, conditionMessage(w)); invokeRestart("muffleWarning") })
  invisible(warns)
}
