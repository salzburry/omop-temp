         else paste0(no_surgery_group, " = patients with no primary-surgery record.")),
  "Age = year of diagnosis - birth year (Flatiron provides birth year only).",
  paste0("Chemotherapy / radiation (1L) = SEER first course. Chemotherapy: DetailedDrugCategory chemotherapy",
         if (count_cetuximab) " or cetuximab" else " (cetuximab not counted)", " in a ", paste(first_course_settings, collapse = ", "),
         " line. Radiation: RT to the primary or an unknown site starting no earlier than ", rt_lookback_days,
