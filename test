         if (!is.null(excl_other_hn)) paste0(" Patients with a code for another head and neck site are excluded: ",
                                             paste(excl_other_hn$site, collapse = "; "), ".")),
  paste0("Baseline variable: Yes = assessed at the index date (initial diagnosis) or in the baseline period (",
