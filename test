dxrow <- function(id, date, col, code) { r <- data.frame(ENROLID = id, SVCDATE = date, DX1 = "I10", DX2 = NA, DX3 = NA, DX4 = NA)
  r[[col]] <- code; r }
build <- function(pts) {
  tb <- list()
  add <- function(name, rows) tb[[name]] <<- bind_rows(tb[[name]], rows)
  for (p in pts) {
    for (e in p$enrol) {
      st <- seq(as.Date(paste0(e[1], "-01")), as.Date(paste0(e[2], "-01")), by = "month")
      st <- st[!format(st, "%Y-%m") %in% p$skip]
      add(paste0(e[3], "t"), data.frame(ENROLID = p$id, DTSTART = format(st),
          DTEND = vapply(seq_along(st), function(i) format(seq(st[i], by = "month", length.out = 2)[2] - 1), ""),
          DOBYR = p$dobyr, SEX = p$sex, RX = ifelse(format(st, "%Y-%m") %in% p$norx, 0, 1)))
    }
    add(paste0(p$db, "o"), dxrow(p$id, "2023-01-05", "DX1", "I10"))                           # not CML
    for (x in p$op) add(paste0(p$db, "o"), dxrow(p$id, x, "DX1", "C9210"))
    for (x in p$dx) add(paste0(p$db, "o"), dxrow(p$id, x[1], x[3], x[2]))
    for (x in p$ip) add(paste0(p$db, "s"), data.frame(ENROLID = p$id, SVCDATE = x, ADMDATE = x, PDX = "C92.10", DX1 = "D64.9", DX2 = NA))
    add(paste0(p$db, "d"), data.frame(ENROLID = p$id, SVCDATE = "2023-01-05", NDCNUM = ndc[["metformin"]], DAYSUPP = 30))
    for (x in p$tki) add(paste0(p$db, "d"), data.frame(ENROLID = p$id, SVCDATE = x[1], NDCNUM = ndc[[x[2]]], DAYSUPP = 30))
  }
  empty <- list(t = data.frame(ENROLID = numeric(), DTSTART = character(), DTEND = character(), DOBYR = numeric(), SEX = numeric(), RX = numeric()),
                o = dxrow(1, "x", "DX1", "x")[0, ], s = data.frame(ENROLID = numeric(), SVCDATE = character(), ADMDATE = character(), PDX = character(), DX1 = character(), DX2 = character()),
                d = data.frame(ENROLID = numeric(), SVCDATE = character(), NDCNUM = character(), DAYSUPP = numeric()))
  for (db in c("ccae", "mdcr")) for (k in names(empty)) if (is.null(tb[[paste0(db, k)]])) tb[[paste0(db, k)]] <- empty[[k]]
  tb$redbook <- redbook
  tb
}
write_db <- function(tb, file) { con <- dbConnect(SQLite(), file); for (n in names(tb)) dbWriteTable(con, n, tb[[n]], overwrite = TRUE); dbDisconnect(con) }

# Runs the script on a fake database; settings changed by `set` (name = R code)
src <- readLines("cml_tki_rdq.R")
run <- function(tb, set = list(), out = file.path(mock_dir, "out")) {
  db <- tempfile(fileext = ".sqlite", tmpdir = mock_dir); write_db(tb, db)
  s <- src
  set <- modifyList(list(ms_schema = '"main"', out_dir = deparse(out)), set)
  for (n in names(set)) {
    i <- grep(paste0("^", n, " +<- "), s); if (length(i) != 1) stop("setting not found: ", n)
    s[i] <- paste(n, "<-", set[[n]])
  }
  s[s == "con <- connect()"] <- "con <- DBI::dbConnect(RSQLite::SQLite(), mock_db, bigint = \"numeric\")"
  env <- new.env(); env$mock_db <- db
  on.exit(if (!is.null(env$con) && DBI::dbIsValid(env$con)) DBI::dbDisconnect(env$con))
  utils::capture.output(eval(parse(text = s), envir = env))
  env
}

