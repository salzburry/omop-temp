-- ===========================================================================
-- RDQ 337084 — PDAC / daraxonrasib
-- STANDALONE DISCOVERY + FUNNEL SQL for Databricks
--
-- Paste into a Databricks SQL editor or notebook and run the blocks in order.
-- No R, no ODBC, no packages. Every block is independent — run one, read it,
-- move on. Blocks 1-8 answer the open empirical questions; block 9 produces the
-- Table 1 attrition funnel in a single query.
--
-- ONE THING TO CHANGE: the cut suffix in the widget below.
--
-- WHAT TO EXPECT BEFORE YOU START:
--   The 2026q1 cut ends 2026-03-31. Expanded access for daraxonrasib opened
--   2026-05-01. So a claims count of ZERO for daraxonrasib is NOT a finding
--   about patients — there is no observation window. A non-zero count in the
--   EHR tables (t_prescription / t_administrations) IS meaningful: it is trial
--   exposure, and NCT05379985 has been PDAC-inclusive since 2022.
-- ===========================================================================

-- Databricks widget; on other engines just find-and-replace ${cut}.
CREATE WIDGET TEXT cut DEFAULT '2026q1';

USE CATALOG hive_metastore;
USE SCHEMA  clnprw_optum_mc_full_use;


-- ===========================================================================
-- 1. DATA CURRENCY  — run this FIRST. It decides whether anything else means
--    anything. If max(fill_dt) is before 2026-05-01, criterion 7 cannot be met
--    in claims however good the code lists are.
-- ===========================================================================
SELECT 't_clm_med_diagnosis.fst_dt'  AS surface, CAST(MAX(fst_dt)  AS STRING) AS max_dt FROM t_clm_med_diagnosis_${cut}
UNION ALL SELECT 't_clm_rx.fill_dt (PAID only)', CAST(MAX(CASE WHEN transaction_type = 'PAID' THEN fill_dt END) AS STRING) FROM t_clm_rx_${cut}
UNION ALL SELECT 't_clm_med_services.fst_dt',    CAST(MAX(fst_dt) AS STRING)   FROM t_clm_med_services_${cut}
UNION ALL SELECT 't_clm_co_enrollment.eligend',  CAST(MAX(eligend) AS STRING)  FROM t_clm_co_enrollment_${cut}
UNION ALL SELECT 't_diagnosis.diag_date',        CAST(MAX(diag_date) AS STRING) FROM t_diagnosis_${cut}
UNION ALL SELECT 't_prescription.rxdate',        CAST(MAX(rxdate) AS STRING)   FROM t_prescription_${cut}
UNION ALL SELECT 't_administrations.order_date', CAST(MAX(order_date) AS STRING) FROM t_administrations_${cut}
UNION ALL SELECT 't_administrations.admin_date', CAST(MAX(admin_date) AS STRING) FROM t_administrations_${cut}
UNION ALL SELECT 't_procedure.proc_date',        CAST(MAX(proc_date) AS STRING) FROM t_procedure_${cut}
UNION ALL SELECT 't_onc_medications.action_date',CAST(MAX(action_date) AS STRING) FROM t_onc_medications_${cut}
ORDER BY surface;


-- ===========================================================================
-- 2. DOES DARAXONRASIB EXIST AT ALL?  Scans every drug-bearing surface for the
--    INN stem "rasib" plus the development codes, in all three punctuations.
--    This is the single most important query in the file.
-- ===========================================================================
WITH hits AS (
  SELECT 't_clm_rx'          AS surface, UPPER(COALESCE(brnd_nm, gnrc_nm)) AS nm, ndc, fill_dt AS dt
  FROM t_clm_rx_${cut}
  WHERE UPPER(COALESCE(brnd_nm,'') || ' ' || COALESCE(gnrc_nm,'')) RLIKE 'RASIB|RMC.?0?70?6236|RASONQUE|DARAXON'
  UNION ALL
  SELECT 't_prescription', UPPER(COALESCE(drug_name, generic_desc)), ndc, rxdate
  FROM t_prescription_${cut}
  WHERE UPPER(COALESCE(drug_name,'') || ' ' || COALESCE(generic_desc,'')) RLIKE 'RASIB|RMC.?0?70?6236|RASONQUE|DARAXON'
  UNION ALL
  SELECT 't_administrations', UPPER(COALESCE(drug_name, generic_desc)), ndc, COALESCE(admin_date, order_date)
  FROM t_administrations_${cut}
  WHERE UPPER(COALESCE(drug_name,'') || ' ' || COALESCE(generic_desc,'')) RLIKE 'RASIB|RMC.?0?70?6236|RASONQUE|DARAXON'
  UNION ALL
  SELECT 't_onc_medications', UPPER(COALESCE(drug_name, generic_desc)), CAST(NULL AS STRING), action_date
  FROM t_onc_medications_${cut}
  WHERE UPPER(COALESCE(drug_name,'') || ' ' || COALESCE(generic_desc,'')) RLIKE 'RASIB|RMC.?0?70?6236|RASONQUE|DARAXON'
)
SELECT surface, nm AS drug_text, ndc,
       COUNT(*) AS n_rows, CAST(MIN(dt) AS STRING) AS first_dt, CAST(MAX(dt) AS STRING) AS last_dt
FROM hits
GROUP BY surface, nm, ndc
ORDER BY n_rows DESC;


-- ===========================================================================
-- 3. EXACT NDCs — closes X-CODES-NAME-ONLY and X-NDC-LABELER-NET.
--    3a: what the 85219 (Revolution Medicines) labeler prefix actually matches.
--        If this returns products that are NOT daraxonrasib, the prefix is a
--        false-positive risk and must be replaced by the exact NDCs.
-- ===========================================================================
SELECT ndc, UPPER(COALESCE(brnd_nm, gnrc_nm)) AS drug_text, COUNT(*) AS n_rows
FROM t_clm_rx_${cut}
WHERE ndc LIKE '85219%'
GROUP BY ndc, UPPER(COALESCE(brnd_nm, gnrc_nm))
ORDER BY n_rows DESC;

--    3b: NDCs for the oral comparators, which currently match on NAME ONLY.
SELECT UPPER(COALESCE(brnd_nm, gnrc_nm)) AS drug_text, ndc, COUNT(*) AS n_rows
FROM t_clm_rx_${cut}
WHERE UPPER(COALESCE(brnd_nm,'') || ' ' || COALESCE(gnrc_nm,''))
      RLIKE 'SOTORASIB|LUMAKRAS|ADAGRASIB|KRAZATI|DIVARASIB|ZOLDONRASIB'
GROUP BY UPPER(COALESCE(brnd_nm, gnrc_nm)), ndc
ORDER BY n_rows DESC;


-- ===========================================================================
-- 4. J-CODE <-> MOLECULE. Confirms the HCPCS mapping on THIS instance. A wrong
--    J-code contributes zero silently rather than erroring, so an empty row
--    here is a finding.
-- ===========================================================================
SELECT proc_cd, COUNT(*) AS n_rows, COUNT(DISTINCT ptid) AS n_pts,
       CAST(MIN(fst_dt) AS STRING) AS first_dt, CAST(MAX(fst_dt) AS STRING) AS last_dt
FROM t_clm_med_services_${cut}
WHERE proc_cd IN (
  'J9201','J9198','J9199','J9196','J9184',      -- gemcitabine
  'J9264',                                       -- nab-paclitaxel
  'J9267',                                       -- paclitaxel
  'J9263','J9206','J9205','J9060','J9190',       -- oxaliplatin, irinotecan, iri-liposomal, cisplatin, 5-FU
  'J0640','J0641','J0642',                       -- leucovorin / levoleucovorin
  'J9045','J9278','C9308','J9171','J9000','J9181','J9280','J9305','J9320','J9070','J9072')
GROUP BY proc_cd
ORDER BY proc_cd;


-- ===========================================================================
-- 5. t_onc_medications.action DOMAIN. The EO exclude lists are worded
--    ('planned','held',...). If this returns codes (1/2/3) or other wording,
--    the lists match NOTHING and planned mentions count as treatment received.
-- ===========================================================================
SELECT data_source, action, COUNT(*) AS n_rows
FROM t_onc_medications_${cut}
GROUP BY data_source, action
ORDER BY n_rows DESC;


-- ===========================================================================
-- 6. PHARMACY REVERSALS. 6a is the rate; 6b is the number the netting cannot
--    see (a REVERSED row with no drug identifier of its own). If 6b is zero,
--    RDQ2_REVERSAL_UNCLASSIFIED = 'ignore' is provably safe.
-- ===========================================================================
SELECT transaction_type, COUNT(*) AS n_rows FROM t_clm_rx_${cut}
GROUP BY transaction_type ORDER BY n_rows DESC;

SELECT COUNT(*) AS n_reversed,
       SUM(CASE WHEN (brnd_nm IS NULL OR TRIM(brnd_nm) = '')
                 AND (gnrc_nm IS NULL OR TRIM(gnrc_nm) = '')
                 AND (ndc     IS NULL OR TRIM(ndc)     = '') THEN 1 ELSE 0 END)
         AS n_no_identifier_at_all
FROM t_clm_rx_${cut}
WHERE transaction_type = 'REVERSED';


-- ===========================================================================
-- 7. SYSTEMIC vs TOPICAL 5-FU. t_clm_rx has no route column, so the split has
--    to come from the NDC. Put the systemic NDCs into the code list; until then
--    every 5-FU regimen row is over-inclusive.
-- ===========================================================================
SELECT ndc, UPPER(COALESCE(brnd_nm, gnrc_nm)) AS drug_text, COUNT(*) AS n_rows
FROM t_clm_rx_${cut}
WHERE UPPER(COALESCE(brnd_nm,'') || ' ' || COALESCE(gnrc_nm,'')) RLIKE 'FLUOROURACIL|ADRUCIL|5.?FU|EFUDEX|CARAC|FLUOROPLEX|TOLAK'
GROUP BY ndc, UPPER(COALESCE(brnd_nm, gnrc_nm))
ORDER BY n_rows DESC;

-- 7b: the EHR side DOES have route/dosage_form — use it to label the NDCs above.
SELECT ndc, UPPER(generic_desc) AS drug_text, LOWER(route) AS route,
       LOWER(dosage_form) AS dosage_form, COUNT(*) AS n_rows
FROM t_prescription_${cut}
WHERE UPPER(COALESCE(drug_name,'') || ' ' || COALESCE(generic_desc,'')) RLIKE 'FLUOROURACIL|ADRUCIL|5.?FU'
GROUP BY ndc, UPPER(generic_desc), LOWER(route), LOWER(dosage_form)
ORDER BY n_rows DESC;


-- ===========================================================================
-- 8. POPULATION SANITY. 8a: the step-1 denominators. 8b: how many patients
--    have an age that cannot be evaluated — a NULL birth_yr makes the adult
--    predicate NULL, so those patients leave the study silently.
-- ===========================================================================
SELECT COUNT(DISTINCT ptid) AS all_pts,
       COUNT(DISTINCT CASE WHEN market_clarity = 'Y' THEN ptid END) AS market_clarity_y,
       COUNT(DISTINCT CASE WHEN has_notes      = 'Y' THEN ptid END) AS has_notes_y,
       COUNT(DISTINCT CASE WHEN birth_yr IS NULL      THEN ptid END) AS birth_yr_null,
       COUNT(DISTINCT CASE WHEN birth_yr = '1936 and Earlier' THEN ptid END) AS birth_yr_1936,
       COUNT(DISTINCT CASE WHEN birth_yr RLIKE '^[0-9]{4}$'   THEN ptid END) AS birth_yr_4digit
FROM t_patient_${cut};

-- 8b: every non-4-digit birth_yr bucket, NULLs included.
SELECT COALESCE(birth_yr, '(NULL)') AS birth_yr, COUNT(*) AS n
FROM t_patient_${cut}
WHERE NOT COALESCE(birth_yr RLIKE '^[0-9]{4}$', FALSE)
GROUP BY COALESCE(birth_yr, '(NULL)')
ORDER BY n DESC;


-- ===========================================================================
-- 9. THE FULL TABLE 1 FUNNEL, claims cohort, in ONE query.
--
--    Mirrors the R pipeline's defaults after the requestor's answers:
--      1  adults (age >= 18 at study end), market_clarity = 'Y'
--      2  >=2 distinct C25 service dates >30 days apart, in the study period
--      3  >=2 distinct metastatic dates (C77/C78, C79.0-C79.89) on/after index
--      4  >=183 days continuous medical coverage before the FIRST METASTATIC date
--      5  exclude C25.4 at any time
--      6  exclude another primary cancer, both dates within [index-180, index]
--      7  first daraxonrasib order in the study period
--
--    Run this to sanity-check the R output against an independent expression of
--    the same logic. If the two disagree, one of them is wrong.
-- ===========================================================================
WITH params AS (
  SELECT DATE'2020-01-01' AS study_start,
         DATE'2026-06-01' AS study_end,
         LEAST(DATE'2026-06-01', DATE'2026-03-31') AS ceiling_dt,   -- cut end
         30  AS visit_gap, 180 AS baseline_days, 183 AS enroll_days
),
-- Step 1 — adults in the Market Clarity population.
s1 AS (
  SELECT DISTINCT p.ptid
  FROM t_patient_${cut} p
  WHERE p.market_clarity = 'Y'
    AND (p.birth_yr = '1936 and Earlier'
         OR (p.birth_yr RLIKE '^[0-9]{4}$' AND CAST(p.birth_yr AS INT) <= 2008))
),
-- Claims diagnosis stream, ICD-10 only, bounded by the cut.
dx AS (
  SELECT d.ptid, d.diag AS cd, d.fst_dt AS dt
  FROM t_clm_med_diagnosis_${cut} d, params
  WHERE d.icd_flag = '10' AND d.fst_dt <= params.ceiling_dt
),
-- Step 2 — >=2 distinct C25 dates more than 30 days apart, inside the study period.
pdac_dates AS (
  SELECT DISTINCT dx.ptid, dx.dt
  FROM dx, params
  WHERE dx.cd IN ('C250','C251','C252','C253','C257','C258','C259')
    AND dx.dt >= params.study_start AND dx.dt <= params.ceiling_dt
),
s2 AS (
  SELECT ptid, MIN(dt) AS index_date
  FROM pdac_dates
  GROUP BY ptid
  HAVING COUNT(DISTINCT dt) >= 2
     AND DATEDIFF(MAX(dt), MIN(dt)) > (SELECT visit_gap FROM params)
),
s2c AS (SELECT s2.* FROM s2 JOIN s1 USING (ptid)),
-- Step 3 — metastatic disease on/after index. C79.9x excluded (literal endpoint).
mets AS (
  SELECT s2c.ptid, MIN(dx.dt) AS mets_date
  FROM dx JOIN s2c USING (ptid), params
  WHERE (SUBSTR(dx.cd, 1, 3) IN ('C77','C78')
         OR (SUBSTR(dx.cd, 1, 3) = 'C79' AND SUBSTR(dx.cd, 1, 4) <> 'C799'))
    AND dx.dt >= s2c.index_date AND dx.dt <= params.ceiling_dt
  GROUP BY s2c.ptid
  HAVING COUNT(DISTINCT dx.dt) >= 2
),
s3 AS (SELECT s2c.ptid, s2c.index_date, mets.mets_date FROM s2c JOIN mets USING (ptid)),
-- Step 4 — >=183 days of continuous coverage before the FIRST METASTATIC date.
-- Spans sharing a start date are collapsed to the longest first, then stitched.
spans AS (
  SELECT ptid, eligeff, MAX(eligend) AS eligend
  FROM t_clm_co_enrollment_${cut}
  WHERE medical_coverage_ind = 'Y'
  GROUP BY ptid, eligeff
),
islands AS (
  SELECT ptid, eligeff, eligend,
         CASE WHEN MAX(eligend) OVER (PARTITION BY ptid ORDER BY eligeff
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) IS NULL
                OR DATEDIFF(eligeff, MAX(eligend) OVER (PARTITION BY ptid ORDER BY eligeff
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING)) > 1
              THEN 1 ELSE 0 END AS new_island
  FROM spans
),
stitched AS (
  SELECT ptid, MIN(eligeff) AS eligeff, MAX(eligend) AS eligend
  FROM (SELECT ptid, eligeff, eligend,
               SUM(new_island) OVER (PARTITION BY ptid ORDER BY eligeff
                                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS island
        FROM islands)
  GROUP BY ptid, island
),
s4 AS (
  SELECT DISTINCT s3.ptid, s3.index_date
  FROM s3 JOIN stitched st USING (ptid), params
  WHERE st.eligeff <= s3.mets_date AND st.eligend >= s3.mets_date
    AND DATEDIFF(s3.mets_date, st.eligeff) >= params.enroll_days
),
-- Step 5 — exclude C25.4 at any observed time.
s5 AS (
  SELECT s4.* FROM s4
  WHERE NOT EXISTS (SELECT 1 FROM dx WHERE dx.ptid = s4.ptid AND dx.cd = 'C254')
),
-- Step 6 — exclude another primary cancer with BOTH dates in [index-180, index].
other_primary AS (
  SELECT s5.ptid
  FROM dx JOIN s5 USING (ptid), params
  WHERE (SUBSTR(dx.cd, 1, 3) RLIKE '^C(0[0-9]|1[0-9]|2[0-4]|2[6-9]|3[0-9]|4[0-3]|4[5-9]|5[0-9]|6[0-9]|7[0-5]|8[1-9]|9[0-7])$'
         -- C76 is a PARTIAL band in the RDQ: C76.0-C76.8, not the whole category.
         OR (SUBSTR(dx.cd, 1, 3) = 'C76' AND SUBSTR(dx.cd, 4, 1) BETWEEN '0' AND '8'))
    AND dx.dt >= DATE_SUB(s5.index_date, params.baseline_days)
    AND dx.dt <= s5.index_date
  GROUP BY s5.ptid
  HAVING COUNT(DISTINCT dx.dt) >= 2
     AND DATEDIFF(MAX(dx.dt), MIN(dx.dt)) > (SELECT visit_gap FROM params)
),
s6 AS (SELECT s5.* FROM s5 WHERE ptid NOT IN (SELECT ptid FROM other_primary)),
-- Step 7 — first daraxonrasib order in the study period (claims: a PAID fill or
-- a medical service line is the only observable proxy for an order).
darax AS (
  SELECT ptid, MIN(dt) AS darax_date FROM (
    SELECT ptid, fill_dt AS dt FROM t_clm_rx_${cut}
    WHERE transaction_type = 'PAID'
      AND (UPPER(COALESCE(brnd_nm,'') || ' ' || COALESCE(gnrc_nm,''))
             RLIKE 'DARAXONRASIB|DARAXON|RASONQUE|RMC.?0?70?6236'
           OR ndc LIKE '85219%')
    UNION ALL
    SELECT ptid, fst_dt FROM t_clm_med_services_${cut}
    WHERE ndc LIKE '85219%'
  ) x, params
  WHERE dt >= params.study_start AND dt <= params.ceiling_dt
  GROUP BY ptid
),
s7 AS (SELECT s6.ptid FROM s6 JOIN darax USING (ptid))
SELECT '1. Adults >=18, Market Clarity'                     AS step, COUNT(*) AS n FROM s1
UNION ALL SELECT '2. Pancreatic cancer (>=2 visits >30d)',        COUNT(*) FROM s2c
UNION ALL SELECT '3. Metastatic disease (>=2 dates, C77-C79.89)', COUNT(*) FROM s3
UNION ALL SELECT '4. >=183d coverage before first metastasis',    COUNT(*) FROM s4
UNION ALL SELECT '5. Exclude C25.4',                              COUNT(*) FROM s5
UNION ALL SELECT '6. Exclude other primary cancer',               COUNT(*) FROM s6
UNION ALL SELECT '7. Daraxonrasib order',                         COUNT(*) FROM s7;


