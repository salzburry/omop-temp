-- ==========================================================================
-- 06_ecog_source_decision.sql
-- Schema: hive_metastore.clnprw_optum_mc_full_use
-- Runnable on its own. Shared conventions and run order: see README.md
-- in this directory. Executed results: results/ (not yet run)
-- ==========================================================================
--
-- ONE DECISION: which table R/nsclc_covariates.R should read ECOG from.
--
-- 05 established that t_onc_evaluation_system holds ECOG for 73,422 lung
-- patients against t_nlp_measure's 54,231. That is an EXISTENCE finding and it
-- is decisive as one. It is NOT a source decision, and the difference is the
-- whole reason this file exists rather than a one-line edit to the extractor.
--
-- THREE THINGS THE COUNT DOES NOT SAY.
--
--   1. 73,422 counts patients with a ROW, not patients with a SCORE. RESULT is
--      varchar(5); the dictionary gives it no vocabulary. Rows whose RESULT is
--      null, or holds a grading token ('High'), or holds prose, are all inside
--      that number. A source with more rows and fewer parseable 0-5 values is
--      worse, not better, and nothing run so far can tell the two apart.
--
--   2. The two sources OVERLAP BY AN UNMEASURED AMOUNT. 73,422 > 54,231 does
--      not mean the second set is contained in the first. If 12,000 patients
--      have an NLP ECOG and no evaluation-system row, a straight swap silently
--      DROPS 12,000 patients from a covariate that is a prognostic anchor of
--      the score. The right change is then coalesce, not switch -- and the
--      difference is invisible from marginal counts.
--
--   3. THE DENOMINATORS ARE NESTED, NOT EQUAL. t_onc_evaluation_system draws
--      from lung INTERSECT Enriched Oncology (cancer dx AND an NLP cancer
--      concept); t_nlp_measure draws from lung INTERSECT has-notes, a strictly
--      LARGER pool. The results doc first called this "like-for-like", which is
--      wrong -- but it is wrong in the finding's favour: the bigger count comes
--      out of the smaller pool, so +35% is a floor. Recorded because a floor
--      and a like-for-like comparison license different claims.
--
-- Six statements, all aggregates, no window functions. Minutes, not hours --
-- 05 was ~21 minutes and this is a smaller cut of the same tables.

USE hive_metastore.clnprw_optum_mc_full_use;

-- Same lung denominator as 01, 04 and 05, repeated verbatim so this file runs
-- on its own and cannot disagree with them about who has lung cancer.
CREATE OR REPLACE TEMPORARY VIEW lung AS
SELECT DISTINCT ptid
FROM   t_diagnosis_2025q4
WHERE  (diagnosis_cd_type = 'ICD10' AND diagnosis_cd LIKE 'C34%')
    OR (diagnosis_cd_type = 'ICD9'  AND diagnosis_cd RLIKE '^162'
        AND NOT diagnosis_cd RLIKE '^1620');


-- ###########################################################################
-- A - what an ECOG row in t_onc_evaluation_system ACTUALLY CONTAINS
-- ###########################################################################

-- A1. ****** THE ONE THAT DECIDES WHETHER THE SOURCE IS USABLE ******
--     The full cross-tabulation of the three value columns on ECOG rows. No
--     LIMIT: if the vocabulary is wide that is itself the answer, and a LIMIT
--     would hide exactly the tail that makes it unparseable.
--
--     WHAT EACH COLUMN IS BEING ASKED.
--       RESULT           varchar(5). Expected '0'..'5'. varchar(5) is wide
--                        enough for '0 - 1' or 'ECOG0', and the extractor's
--                        parser has to be written against what is there.
--       RESULT_NARRATIVE varchar(17). Its DOCUMENTED vocabulary is
--                        High/Intermediate/Low, which is GRADING terminology --
--                        Nottingham and Gleason share this table. What it holds
--                        on an ECOG row has never been observed. Do not assume
--                        it is the score and do not assume it is empty.
--       TEMPORAL_STATUS  varchar(7). Documented history/current, no 'plan'. If
--                        a third value appears, the biomarker lesson repeats:
--                        04's own C2/C3 filtered IN ('current','history') and
--                        discarded 117,040 patients whose status was NULL.
--
--     NULLs are counted, not filtered. "How many rows have no result" is the
--     question; a WHERE clause that drops them answers a different one.
SELECT e.result,
       e.result_narrative,
       e.temporal_status,
       COUNT(*)                AS n_rows,
       COUNT(DISTINCT e.ptid)  AS n_patients
FROM   t_onc_evaluation_system_2025q4 e
JOIN   lung l ON l.ptid = e.ptid
WHERE  e.system_name = 'ECOG performance status'
GROUP  BY e.result, e.result_narrative, e.temporal_status
ORDER  BY n_rows DESC;

-- A2. The headline number A1 breaks down: how many of the 73,422 have at least
--     one row whose RESULT parses as a bare 0-5.
--
--     THIS IS THE NUMBER THAT COMPARES TO 54,231, and 73,422 is not. If it
--     comes in below 54,231 then t_nlp_measure stays primary and the rest of
--     this file is moot -- t_onc_evaluation_system has more ROWS about ECOG and
--     fewer PATIENTS WITH A SCORE, which is the opposite of an upgrade.
--
--     '^[0-5]$' is deliberately strict. Whatever A1 shows can be admitted
--     later on purpose; admitting it here by writing a loose pattern first
--     would fold the parser question into the count and lose it.
SELECT COUNT(DISTINCT e.ptid)                                              AS n_any_row,
       COUNT(DISTINCT CASE WHEN e.result RLIKE '^[0-5]$'
                           THEN e.ptid END)                                AS n_parseable_result,
       COUNT(DISTINCT CASE WHEN e.result IS NULL
                            AND e.result_narrative IS NULL
                           THEN e.ptid END)                                AS n_both_value_cols_null
FROM   t_onc_evaluation_system_2025q4 e
JOIN   lung l ON l.ptid = e.ptid
WHERE  e.system_name = 'ECOG performance status';


-- ###########################################################################
-- B - how far the two sources overlap
-- ###########################################################################

-- B1. ****** THE ONE THAT DECIDES SWITCH vs COALESCE ******
--     A FULL OUTER JOIN of the two patient sets. Marginal counts cannot answer
--     this: 73,422 and 54,231 are consistent with total containment and with
--     almost no overlap, and those imply opposite changes to the extractor.
--
--     READING THE OUTPUT.
--       nlp_only ~ 0        -> t_nlp_measure adds nothing. Switch.
--       nlp_only material   -> COALESCE, not switch. Read the evaluation system
--                              first and fall back to NLP. nlp_only is exactly
--                              the patient count a swap would throw away, and
--                              it is a per-patient loss on a covariate that
--                              carries the prognostic score.
--       union_total         -> what a coalescing extractor gets. If it exceeds
--                              73,422 -- which it does whenever nlp_only > 0 --
--                              then neither single source is the best answer.
--
--     Both sides are restricted to lung inside the subqueries, so the join is
--     patient-to-patient on the same denominator and no row multiplies.
WITH eo AS (
    SELECT DISTINCT e.ptid
    FROM   t_onc_evaluation_system_2025q4 e
    JOIN   lung l ON l.ptid = e.ptid
    WHERE  e.system_name = 'ECOG performance status'
), nlp AS (
    SELECT DISTINCT m.ptid
    FROM   t_nlp_measure_2025q4 m
    JOIN   lung l ON l.ptid = m.ptid
    WHERE  m.measurement_type = 'ECOG'
)
SELECT COUNT(*)                                                    AS union_total,
       COUNT(CASE WHEN nlp.ptid IS NULL THEN 1 END)                AS eo_only,
       COUNT(CASE WHEN eo.ptid IS NOT NULL
                   AND nlp.ptid IS NOT NULL THEN 1 END)            AS both,
       COUNT(CASE WHEN eo.ptid IS NULL THEN 1 END)                 AS nlp_only
FROM   eo FULL OUTER JOIN nlp ON eo.ptid = nlp.ptid;

-- B2. The same question one level deeper, for the coalesce case only. Among
--     patients in BOTH, do the two sources agree on the score?
--
--     A coalescing extractor picks a winner per patient, and "prefer the
--     evaluation system" is only defensible if the two do not systematically
--     disagree. Nearest-in-time is not compared here -- this is the crude
--     version: the set of distinct values each source ever recorded, per
--     patient. Wholesale disagreement means the two are not measuring the same
--     thing and neither should silently override the other.
--
--     LIMIT 200 because this is a shape question, not a count.
--     DISTINCT INSIDE BOTH CTEs, NOT OPTIONAL. Without it this joins 736,635
--     rows against 245,158 on ptid and multiplies serial assessments together;
--     COUNT(DISTINCT ptid) would still be right and the query would still be
--     the most expensive statement in this directory. Deduping to one row per
--     (patient, value) makes it a set comparison, which is the question.
WITH eo AS (
    SELECT DISTINCT e.ptid, e.result AS eo_val
    FROM   t_onc_evaluation_system_2025q4 e
    JOIN   lung l ON l.ptid = e.ptid
    WHERE  e.system_name = 'ECOG performance status'
      AND  e.result RLIKE '^[0-5]$'
), nlp AS (
    SELECT DISTINCT m.ptid, m.measurement_value AS nlp_val
    FROM   t_nlp_measure_2025q4 m
    JOIN   lung l ON l.ptid = m.ptid
    WHERE  m.measurement_type = 'ECOG'
      AND  m.measurement_value RLIKE '^[0-5]$'
)
SELECT eo.eo_val,
       nlp.nlp_val,
       COUNT(DISTINCT eo.ptid) AS n_patients
FROM   eo JOIN nlp ON eo.ptid = nlp.ptid
GROUP  BY eo.eo_val, nlp.nlp_val
ORDER  BY n_patients DESC
LIMIT  200;
--     NOTE ON THE COLUMN NAME. MEASUREMENT_VALUE is the dictionary's name
--     (Character(150)) and is what nc_ecog() in R/nsclc_covariates.R already
--     reads, so an error here would break the extractor too. But t_nlp_measure
--     is one of the eight tables ABSENT from the only live DESCRIBE we hold
--     (optum_capability_inventory.md, open questions), so its deployed name and
--     casing are PDF-derived. If B2 errors on an unresolved column, run
--     DESCRIBE t_nlp_measure_2025q4 and substitute -- that is a naming miss,
--     and it is also a defect in the R reader.                   # UNVERIFIED
--
--     NOTE ON THE RANGE. A1/A2 above admit '^[0-5]$' because the Enriched
--     Oncology manual p.4 sec 1.3 documents ECOG as 0-5 and says Optum QCs the
--     frequency of each score. nc_ecog() bounds it at 0-4. Both are defensible
--     -- ECOG 5 is death, which cannot be a baseline covariate for a patient
--     alive at index -- but they are different, and the wider bound is used
--     here on purpose so the output SHOWS how many 5s exist instead of hiding
--     them behind the extractor's own filter.


-- ###########################################################################
-- C - settle the transcription that could not be read off the scan
-- ###########################################################################

-- C1. The three rows under ECOG in 05's B1 output, re-run so they are read
--     from a result set instead of from a rotated photograph.
--
--     The scan admits two readings, and they disagree about which label owns
--     which count:
--         reading 1   (null) 66,248/16,770 · Karnofsky 54,714/12,262
--                     · Performance Status 34,904/10,476
--         reading 2   Karnofsky 66,248/16,770 · (null) 54,714/12,262
--                     · Performance Status n_rows 34,494
--
--     An earlier note argued the pairing was self-proving because n_patients
--     descends monotonically. THAT ARGUMENT IS VOID: monotonicity is a property
--     of the numeric column alone and survives any relabelling of the rows
--     beside it. The ECOG row is unaffected either way -- it is the top row of
--     a descending sort with no competitor -- but the Karnofsky headline count
--     is 16,770 under one reading and 12,262 under the other, and
--     optum_covariate_coverage.csv is about to be corrected with it.
--
--     COALESCE makes the null row print as a label rather than as blank space,
--     which is how the ambiguity got in.
SELECT COALESCE(e.system_name, '<<NULL>>') AS system_name,
       COUNT(*)               AS n_rows,
       COUNT(DISTINCT e.ptid) AS n_patients
FROM   t_onc_evaluation_system_2025q4 e
JOIN   lung l ON l.ptid = e.ptid
WHERE  e.system_name IS NULL
    OR e.system_name IN ('Karnofsky Performance Status', 'Performance Status')
GROUP  BY COALESCE(e.system_name, '<<NULL>>')
ORDER  BY n_patients DESC;   -- same ORDER BY as 05 B1, so the rows come back in
                             -- the same sequence and the readings can be matched
                             -- against the scan line for line.

-- C2. What the NULL system_name rows are. 05 left a five-figure block of rows
--     with no system name and nothing was said about them; if they are
--     unlabelled performance status they belong in the ECOG source, and if they
--     are unlabelled grading they do not.
SELECT e.result,
       e.result_narrative,
       COUNT(*)               AS n_rows,
       COUNT(DISTINCT e.ptid) AS n_patients
FROM   t_onc_evaluation_system_2025q4 e
JOIN   lung l ON l.ptid = e.ptid
WHERE  e.system_name IS NULL
GROUP  BY e.result, e.result_narrative
ORDER  BY n_rows DESC
LIMIT  100;


-- ###########################################################################
-- D - what each answer changes in the code
-- ###########################################################################
--
--   A2 parseable < 54,231
--       t_nlp_measure STAYS primary. The existence finding stands and the
--       source does not change. Record the parseable count next to 73,422 in
--       the results file so the marginal count is never read as a score count
--       again.
--
--   A2 parseable > 54,231 AND B1 nlp_only ~ 0
--       Switch. NC_NLP_TYPE['ecog'] becomes the fallback, nc_ecog() reads
--       t_onc_evaluation_system first, and the parser is written against A1's
--       observed RESULT vocabulary rather than against '0'-'5' by assumption.
--
--   A2 parseable > 54,231 AND B1 nlp_only material
--       COALESCE. nc_ecog() reads both, prefers the evaluation system per
--       patient, and falls back to NLP. B2 says whether that preference is
--       defensible or whether the two sources disagree badly enough that
--       neither can override the other. This is the outcome the marginal
--       counts cannot distinguish from the one above, and it is the reason the
--       source change was held rather than made from 05 alone.
--
--   A1 shows a TEMPORAL_STATUS value outside history/current
--       The biomarker lesson repeats. Decide the exclusion on what the value
--       MEANS, not on which values happen to be frequent -- 04's C2/C3 excluded
--       by an inclusion list and dropped 117,040 NULL-status patients.
--
--   C1 / C2
--       Corrects the Karnofsky count in the results file and in
--       optum_covariate_coverage.csv, and says whether the unlabelled block is
--       performance status.
--
-- SAVE EVERY RESULT SET, INCLUDING THE EMPTY ONES, and save them as text rather
-- than as photographs -- C1 exists only because the last run came back as a
-- rotated scan and two readers paired the same three rows differently.
