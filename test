--
-- FIVE OF PHOEBE'S 18 COVARIATES ARE BLOCKED ON ONE THING: nobody knows what
-- an analyte is called in this deployment. Albumin, ALP, haemoglobin,
-- platelets and NLR all live in t_lab, the table is read by the engine for R24
-- activity, and its ANALYTE vocabulary has never been scanned. No analyte name
-- appears in any of the ten vendor PDFs and the TEST_TYPE lookup tab is absent,
-- so a DISTINCT scan IS the vocabulary -- the same position t_nlp_measure was
-- in before 04, and the same fix.
--
-- COLUMN NAMES HERE ARE LIVE-DESCRIBE VERIFIED (optum_table_inventory.csv:
-- t_lab 33 columns, t_clm_lab_results 16). They are not from the dictionary.
--
-- THREE HAZARDS THIS FILE IS SHAPED AROUND, all documented before it ran:
--
--   1. NO SPECIMEN-TYPE COLUMN on either lab table. Serum-vs-urine separation
--      rests ENTIRELY on the name string, so 'microalbumin' and 'albumin' are
--      distinguished by text or not at all. A1 returns the names precisely so
--      that separation can be made on evidence.
--
--   2. THE DIFFERENTIAL IS THE NLR PROBLEM. Neutrophils and lymphocytes are
--      reported both as a PERCENT and as an ABSOLUTE count, and NLR needs
--      absolutes. Whether anything beyond TEST_NAME and RESULT_UNIT
--      distinguishes them is unresolved by any document (EO/Optum question 22).
--      B2 is written to show both forms side by side rather than to assume one.
--
--   3. AN ENGLISH-WORD PROBE MISSES TERSE CODES. 04's A4 searched
--      ecog|performance|karnofsky|kps and found nothing, while the same probe
--      in the same table missed SBP, DBP, WT and HT because Optum uses terse
--      codes. So A1 -- the UNFILTERED list -- is the evidence here, and B1's
--      targeted probe is a convenience. If they disagree, A1 wins.

USE dvmt_rwop.rwd_optum_marketclarity_25q4;

-- Same lung denominator as 01/04/05/06/07/08, verbatim.
CREATE OR REPLACE TEMPORARY VIEW lung AS
SELECT DISTINCT ptid
FROM   t_diagnosis
WHERE  (diagnosis_cd_type = 'ICD10' AND diagnosis_cd LIKE 'C34%')
    OR (diagnosis_cd_type = 'ICD9'  AND diagnosis_cd RLIKE '^162'
        AND NOT diagnosis_cd RLIKE '^1620');


-- ###########################################################################
-- PART A - the vocabulary itself
-- ###########################################################################

-- A1. ****** THE ONE THAT UNBLOCKS THE FIVE COVARIATES ******
--     Every analyte in the lung cohort, by patient count. LOINC alongside the
--     name because LOINC is the stable key and TEST_NAME is LOINC
--     long-common-name style, so the pair is what a codelist gets written
--     against.
--
--     LIMIT 1000 and not 50: the five we need are common and will be near the
--     top, but the TAIL is where a second spelling of the same analyte hides,
--     and a codelist built from the head alone silently drops it. SAVE ALL
--     ROWS -- this output IS the reference document, exactly as 04's B2 became
--     the only copy of the t_nlp_measure vocabulary.
SELECT l.loinc,
       l.test_name,
       l.result_unit,
       COUNT(*)               AS n_rows,
       COUNT(DISTINCT l.ptid) AS n_patients
FROM   t_lab l
JOIN   lung g ON g.ptid = l.ptid
GROUP  BY l.loinc, l.test_name, l.result_unit
ORDER  BY n_patients DESC
LIMIT  1000;

-- A2. How many distinct analytes exist at all, so it is possible to say
--     whether A1's 1,000 rows are the whole list or a truncation. If this
--     comes back above 1,000, A1 is a head and the tail is unread -- say so
--     rather than treating A1 as complete.
SELECT COUNT(*) AS n_distinct_loinc_name_unit
FROM  (SELECT DISTINCT l.loinc, l.test_name, l.result_unit
       FROM   t_lab l JOIN lung g ON g.ptid = l.ptid) x;


-- ###########################################################################
-- PART B - the five, and the differential trap
-- ###########################################################################

-- B1. The targeted probe. A CONVENIENCE, not the evidence -- see hazard 3.
--     Deliberately wide: 'albumin' catches microalbumin so the specimen
--     ambiguity is visible rather than silently included, and both the
--     percent and absolute differential spellings are wanted.
SELECT l.loinc, l.test_name, l.result_unit,
       COUNT(*)               AS n_rows,
       COUNT(DISTINCT l.ptid) AS n_patients
FROM   t_lab l
JOIN   lung g ON g.ptid = l.ptid
WHERE  upper(l.test_name) RLIKE
       'ALBUMIN|ALKALINE|PHOSPHATASE|HEMOGLOB|HAEMOGLOB|PLATELET|NEUTROPHIL|LYMPHOCYTE|ANC|ALC|WBC|LEUKOCYTE'
GROUP  BY l.loinc, l.test_name, l.result_unit
ORDER  BY n_patients DESC;

-- B2. ****** THE NLR MAKE-OR-BREAK ******
--     Percent and absolute, side by side, for the two differential analytes.
--     NLR needs ABSOLUTE counts; a ratio built from percentages is a different
--     quantity and is not comparable to any published NLR cut-point.
--
--     RESULT_UNIT is the discriminator if anything is: '%' versus '10*3/uL' or
--     'K/uL'. If both forms share a unit string, or the unit is null, then
--     TEST_NAME is the only discriminator and that is a finding worth stating
--     plainly rather than working around.
SELECT CASE WHEN upper(l.test_name) RLIKE 'NEUTROPHIL' THEN 'neutrophil'
            WHEN upper(l.test_name) RLIKE 'LYMPHOCYTE' THEN 'lymphocyte'
            ELSE 'other' END                       AS analyte,
       l.result_unit,
       l.result_datatype,
       COUNT(*)                                    AS n_rows,
       COUNT(DISTINCT l.ptid)                      AS n_patients,
       MIN(l.test_name)                            AS example_name
FROM   t_lab l
JOIN   lung g ON g.ptid = l.ptid
WHERE  upper(l.test_name) RLIKE 'NEUTROPHIL|LYMPHOCYTE'
GROUP  BY 1, l.result_unit, l.result_datatype
ORDER  BY n_rows DESC;

-- B3. The value shape, for the unit map and the parser. TEST_RESULT is
--     Character(635) -- a free-text field, not a number -- so this is the
--     PD-L1 NUMERIC_RESULT question again: how much of it parses.
--
--     RELATIVE_INDICATOR ('<','>','<=','>=','==') is returned because an
--     inequality is a different finding from a value, and 04's PD-L1 work
--     established that carrying it beats discarding it.
SELECT l.result_datatype,
       l.relative_indicator,
       l.normalized_result,
       l.standard_units,
       COUNT(*)                                                        AS n_rows,
       SUM(CASE WHEN l.test_result RLIKE '^[0-9]+(\.[0-9]+)?$'
                THEN 1 ELSE 0 END)                                     AS n_bare_numeric
FROM   t_lab l
JOIN   lung g ON g.ptid = l.ptid
WHERE  upper(l.test_name) RLIKE
       'ALBUMIN|ALKALINE|PHOSPHATASE|HEMOGLOB|PLATELET|NEUTROPHIL|LYMPHOCYTE'
GROUP  BY 1, 2, 3, 4
ORDER  BY n_rows DESC;


-- ###########################################################################
-- PART C - the second, independent lab source
-- ###########################################################################

-- C1. t_clm_lab_results. A SECOND lab source that was never considered until
--     the reference read turned it up, and it has fields t_lab lacks --
--     HI_NRML/LOW_NRML numeric reference bounds and an abnormality code.
--     Different column names entirely: LOINC_CD, TST_DESC, RSLT_UNIT_NM.
SELECT c.loinc_cd, c.tst_desc, c.rslt_unit_nm,
       COUNT(*)               AS n_rows,
       COUNT(DISTINCT c.ptid) AS n_patients
FROM   t_clm_lab_results c
JOIN   lung g ON g.ptid = c.ptid
GROUP  BY c.loinc_cd, c.tst_desc, c.rslt_unit_nm
ORDER  BY n_patients DESC
LIMIT  500;

-- C2. RSLT_NBR versus RSLT_TXT, which the vendor warns about VERBATIM: "not
--     all vendors give a separate numeric field. Numeric results may also be
--     in the Result Text field." If RSLT_NBR is sparse, every claims-side lab
--     value needs parsing out of an 18-character text field, and TST_DESC is
--     documented as "specific to each laboratory vendor" -- i.e. not a
--     controlled vocabulary at all.
SELECT COUNT(*)                                                   AS n_rows,
       COUNT(c.rslt_nbr)                                          AS n_rslt_nbr,
       ROUND(100.0 * COUNT(c.rslt_nbr) / COUNT(*), 2)             AS pct_nbr,
       SUM(CASE WHEN c.rslt_txt IS NOT NULL
                 AND trim(c.rslt_txt) <> '' THEN 1 ELSE 0 END)    AS n_rslt_txt,
       COUNT(c.rslt_unit_nm)                                      AS n_unit
FROM   t_clm_lab_results c
JOIN   lung g ON g.ptid = c.ptid;


-- ###########################################################################
-- PART D - what each answer unblocks
-- ###########################################################################
--
--   A1  THE DELIVERABLE. Five of Phoebe's 18 become writable WHERE clauses.
--       Save every row: it is the only copy of this vocabulary, as 04's B2 is
--       for t_nlp_measure.
--
--   A2  Says whether A1 is the list or the head of it.
--
--   B2  Decides whether NLR is feasible AT ALL. Absolute neutrophil and
--       lymphocyte counts present -> feasible. Percent only -> NLR cannot be
--       built from t_lab without a WBC to multiply through, and that is a
--       derivation with its own error, not a measurement.
--
--   B3  The parser. TEST_RESULT is free text; this is how much of it is a bare
--       number and how much carries an inequality.
--
--   C1/C2  Whether the claims lab source adds patients or is a parsing
--       liability. Both may be true.
--
-- WHAT THIS FILE DELIBERATELY DOES NOT DO: the same-day neutrophil-plus-
-- lymphocyte co-occurrence rate, which is the number that decides whether NLR
-- is computable per patient. It is NOT here because it must be run against a
-- FROZEN analyte allow-list -- run it on a guessed list and the co-occurrence
-- rate is a property of the guess. It is a follow-up to this file, after A1
-- and B2 are read.
